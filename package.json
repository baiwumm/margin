{
  "name": "margin",
  "type": "module",
  "version": "1.7.0",
  "packageManager": "pnpm@12.6.0",
  "description": "Margin（原 Devosfera）：基于 AstroPaper 深度二次开发的个人技术博客 + 图片画廊（纯静态站点）。",
  "homepage": "https://www.baiwumm.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiwumm/margin.git"
  },
  "author": {
    "name": "白雾茫茫丶",
    "email": "me@baiwumm.com",
    "url": "https://github.com/baiwumm"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/prune-assets.mjs && pagefind --site dist && node -e \"fs.cpSync('dist/pagefind','public/pagefind',{recursive:true})\"",
    "assets:prune": "node scripts/prune-assets.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "images": "node scripts/compress-images.mjs",
    "hooks": "git config core.hooksPath scripts/githooks",
    "release": "release-it"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@pagefind/default-ui": "^1.6.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "pinyin-pro": "^3.29.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-it": "^21.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
