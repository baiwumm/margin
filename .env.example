# ─────────────────────────────────────────────────────────────────────────────
# Margin — Environment Variables
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit personal data to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Social links (profile sidebar & footer) ───────────────────────────────
# Leave any of these empty (or remove the line) to hide that social link.

PUBLIC_SOCIAL_GITHUB=https://github.com/your-username
PUBLIC_SOCIAL_X=https://x.com/your-handle
PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-profile
PUBLIC_SOCIAL_EMAIL=your@email.com

# ── Google Search Console verification (optional) ─────────────────────────
# PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# ─── Giscus comments (GitHub Discussions) ────────────────────────────────────
# 评论仓库必须是 public；可以单独建一个只存放评论的空仓库，博客源码可保持私有。
# 到 https://giscus.app 填写仓库信息后生成 repoId / categoryId，
# 然后在 src/config.ts 将 SITE.comments.enabled 置为 true。
PUBLIC_GISCUS_REPO=your-username/your-comments-repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=

# ── GitHub Token（Projects 页面构建期拉取 stars/forks，可选）──────────────────
# 私有变量，不要用 PUBLIC_ 前缀（否则会打进客户端产物导致 Token 泄漏）。
# 在 GitHub → Settings → Developer settings → Fine-grained tokens 生成，
# 只需公共仓库 Metadata 只读权限。未配置时 Projects 页面使用静态数字。
GITHUB_TOKEN=
