// Cloudflare Workers(Static Assets)部署配置:纯静态站点,无 Worker 代码。
// 构建产物为 dist/,由 Cloudflare Dashboard 连接 Git 仓库自动构建部署。
// 文档:https://developers.cloudflare.com/workers/static-assets/
{
  "name": "margin",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    // /posts/xxx/ 目录式 URL 自动匹配 index.html,无斜杠请求 308 补斜杠
    "html_handling": "auto-trailing-slash",
    // 未命中路径返回 404.html(Astro 已生成)
    "not_found_handling": "404-page"
  }
}
