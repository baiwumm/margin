{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "$host",
      "destination": "$wwwhost",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/giscus/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
