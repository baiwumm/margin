# Normalize line endings: LF in repo and working tree on all platforms.
# Prettier enforces `endOfLine: "lf"`, so checkout must not convert to CRLF
# (git `core.autocrlf=true` on Windows would otherwise break `format:check`).
* text=auto eol=lf

# Binary assets (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
