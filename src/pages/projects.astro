---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EmptyState from "@/components/EmptyState.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ContributionCalendar from "@/components/ContributionCalendar.astro";
import { projects } from "@/data/projects";
import { getProjectStats } from "@/utils/projectStats";
import { SITE } from "@/config";

const { projects: effectiveProjects, unmatched, accountStars, joinedAt } =
  await getProjectStats(projects);
const featuredProjects = effectiveProjects.filter(({ featured }) => featured);
const regularProjects = effectiveProjects.filter(({ featured }) => !featured);
const totalProjects = effectiveProjects.length;

// 加入 GitHub 的相对时长（构建期计算，不足一年按月展示）
let joinedLabel: string | undefined;
if (joinedAt) {
  const ms = Date.now() - new Date(joinedAt).getTime();
  const years = Math.floor(ms / (365.25 * 24 * 60 * 60 * 1000));
  if (years >= 1) {
    joinedLabel = `${years} 年`;
  } else {
    joinedLabel = `${Math.max(1, Math.floor(ms / (30 * 24 * 60 * 60 * 1000)))} 个月`;
  }
}
---

<Layout
  title={`Projects | ${SITE.title}`}
  description="我的开源项目与作品，描述与技术栈实时同步自 GitHub。"
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-8">
    {
      import.meta.env.DEV && unmatched && (
        <div class="mb-4 rounded-lg border border-featured/40 bg-featured/10 px-4 py-3 text-sm text-featured">
          以下配置的仓库未在 GitHub 上找到（已跳过，请检查拼写）：
          {unmatched.join("、")}
        </div>
      )
    }
    <!-- Hero -->
    <div class="projects-hero" data-projects-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-projects-mouse></div>

      <div class="relative z-10">
        <!-- Terminal prompt badge -->
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/40 bg-muted/20 px-3.5 py-1.5 font-firacode text-xs sm:text-sm"
        >
          <span class="text-accent">~</span>
          <span>/projects</span>
          <span class="opacity-40">$</span>
          <span class="opacity-60">ls -la</span>
        </div>

        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">Projects</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          我的开源项目与作品。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {accountStars ? (
            <span class="hero-badge">{accountStars} Stars</span>
          ) : null}
          <span class="hero-badge">{totalProjects} 个开源项目</span>
          {joinedLabel && (
            <span class="hero-badge">加入 GitHub {joinedLabel}</span>
          )}
        </div>
      </div>
    </div>

    <!-- GitHub 贡献日历 -->
    <ContributionCalendar />

    <!-- Projects Grid -->
    <div class="w-full">
      {
        effectiveProjects.length === 0 ? (
          <EmptyState
            title="还没有开源项目"
            description="稍后再来看看，这里会有新的项目。"
          />
        ) : (
          <ul
            data-pagefind-body
            class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 [&>li]:my-0"
          >
            {featuredProjects.map(project => (
              <ProjectCard {...project} />
            ))}
            {regularProjects.map(project => (
              <ProjectCard {...project} />
            ))}
          </ul>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>

<script>
  let cleanupController: AbortController | null = null;

  function initProjectsPage() {
    if (cleanupController) cleanupController.abort();
    cleanupController = new AbortController();
    const { signal } = cleanupController;

    // Hero mouse glow
    const hero = document.querySelector("[data-projects-hero]") as HTMLElement;
    const heroMouse = document.querySelector(
      "[data-projects-mouse]"
    ) as HTMLElement;

    if (hero && heroMouse) {
      hero.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            heroMouse.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            heroMouse.style.setProperty("--my", `${e.clientY - rect.top}px`);
            heroMouse.style.opacity = "1";
          });
        },
        { signal }
      );

      hero.addEventListener(
        "mouseleave",
        () => {
          heroMouse.style.opacity = "0";
        },
        { signal }
      );
    }
  }

  document.addEventListener("astro:page-load", initProjectsPage);
</script>

<style>
  .projects-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    margin-bottom: 2rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  @media (min-width: 640px) {
    .projects-hero {
      padding: 3rem;
    }
  }
</style>
