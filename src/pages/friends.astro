---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EmptyState from "@/components/EmptyState.astro";
import FriendGroup from "@/components/FriendGroup.astro";
import Comments from "@/components/Comments.astro";
import { SITE } from "@/config";
import { friendGroups, friendsByGroup, allFriends } from "@/data/friends";
import IconCopy from "@/assets/icons/IconCopy.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import { PUBLIC_SOCIAL_EMAIL } from "astro:env/client";

// 分组按数据渲染，空组自动过滤
const visibleGroups = friendGroups
  .map(group => ({
    group,
    friends: friendsByGroup[group.id] ?? [],
  }))
  .filter(({ friends }) => friends.length > 0);

const totalCount = allFriends.length;

// —— 本站信息（用于友链申请复制）——
const siteInfoRows: { label: string; value: string }[] = [
  { label: "站名", value: SITE.title },
  { label: "作者", value: SITE.author },
  { label: "描述", value: SITE.desc },
  { label: "地址", value: SITE.website },
  { label: "头像", value: new URL("avatar.png", SITE.website).toString() },
];
const emailValue = PUBLIC_SOCIAL_EMAIL ?? "";
const rssUrl = new URL("rss.xml", SITE.website).toString();

// —— 一键填充申请内容（复制到评论区提交）——
const applicationText = [
  `name: ${SITE.title}`,
  `description: ${SITE.desc}`,
  `url: ${SITE.website}`,
  `avatar: ${new URL("avatar.png", SITE.website).toString()}`,
  "",
  "您好博主，本站已添加贵站友链，想申请与贵站互链。以上是本站信息，麻烦审核一下，感谢！",
].join("\n");
---

<Layout
  title={`Friends | ${SITE.title}`}
  description="与我的博客互链的小伙伴们，以及友链申请须知。"
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-4">
    <!-- Hero -->
    <div class="friends-hero" data-friends-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-friends-mouse></div>

      <div class="relative z-10">
        <!-- Terminal prompt badge -->
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/40 bg-muted/20 px-3.5 py-1.5 font-firacode text-xs sm:text-sm"
        >
          <span class="text-accent">~</span>
          <span>/friends</span>
          <span class="opacity-40">$</span>
          <span class="opacity-60">ls -la</span>
        </div>

        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">Friends</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          在互联网上串门结识的博客伙伴们，欢迎相互取暖、共同成长。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="hero-badge">{friendGroups.length} 个分组</span>
          <span class="hero-badge">{totalCount} 位友人</span>
        </div>
      </div>
    </div>

    <!-- 纯头像分组渲染 -->
    <div class="w-full">
      {
        visibleGroups.length === 0 ? (
          <EmptyState
            title="还没有可展示的友链"
            description="欢迎在下方评论区留言申请友链，或查看本站信息后先在博客里加上我。"
          />
        ) : (
          visibleGroups.map(({ group, friends }) => (
            <FriendGroup group={group} friends={friends} />
          ))
        )
      }
    </div>

    <!-- 友链须知 + 本站信息 -->
    <section
      class="mt-12 grid gap-6 lg:grid-cols-[44%_1fr]"
      aria-label="友链须知与本站信息"
    >
      <div class="info-panel">
        <div class="info-panel-heading">
          <span
            class="h-1.5 w-1.5 rounded-full bg-accent/70 shadow-[0_0_8px_var(--color-accent)]"
          ></span>
          <h2
            class="font-firacode text-[10px] tracking-widest text-accent/80 uppercase"
          >
            友链须知
          </h2>
        </div>
        <ul class="info-list">
          <li class="info-item">
            <span class="info-num">1</span>
            <span class="info-item-body">
              <span class="info-item-title">站点定位</span>
              <span class="info-item-text"
                >优先个人博客、技术笔记、生活记录、开源项目主页；不收纯广告、采集、营销或跳转聚合站。</span
              >
            </span>
          </li>
          <li class="info-item">
            <span class="info-num">2</span>
            <span class="info-item-body">
              <span class="info-item-title">内容质量</span>
              <span class="info-item-text"
                >内容稳定真实、原创或认真整理；避免整站搬运、AI
                批量灌水与严重同质化。</span
              >
            </span>
          </li>
          <li class="info-item">
            <span class="info-num">3</span>
            <span class="info-item-body">
              <span class="info-item-title">合规底线</span>
              <span class="info-item-text"
                >不含违法违规、色情、赌博、诈骗、侵权盗版等内容，违者直接移除友链。</span
              >
            </span>
          </li>
          <li class="info-item">
            <span class="info-num">4</span>
            <span class="info-item-body">
              <span class="info-item-title">访问与安全</span>
              <span class="info-item-text"
                >站点稳定可达、建议启用
                HTTPS；长期无法访问或证书异常会暂时下架。</span
              >
            </span>
          </li>
          <li class="info-item">
            <span class="info-num">5</span>
            <span class="info-item-body">
              <span class="info-item-title">互惠与维护</span>
              <span class="info-item-text"
                >申请前先添加本站；若移除本站链接将同步取消，误判可联系恢复。</span
              >
            </span>
          </li>
        </ul>
      </div>

      <div class="info-panel">
        <div class="info-panel-heading">
          <span
            class="h-1.5 w-1.5 rounded-full bg-accent/70 shadow-[0_0_8px_var(--color-accent)]"
          ></span>
          <h2
            class="font-firacode text-[10px] tracking-widest text-accent/80 uppercase"
          >
            本站信息
          </h2>
        </div>

        <!-- 个人名片 Header -->
        <div class="info-profile">
          <img
            src="/avatar.png"
            alt={`${SITE.title} 头像`}
            width={52}
            height={52}
            class="info-avatar"
            loading="lazy"
          />
          <div class="min-w-0">
            <p
              class="truncate font-firacode text-lg font-semibold text-foreground"
            >
              {SITE.title}
            </p>
            <p class="truncate text-xs text-foreground/50">{SITE.author}</p>
          </div>
        </div>

        <div class="info-divider" role="separator" aria-hidden="true"></div>

        <ul class="info-list">
          {
            siteInfoRows.map(row => (
              <li class="info-row">
                <span class="info-row-label">{row.label}</span>
                <span class="info-value min-w-0 flex-1 truncate text-foreground/70">
                  {row.value}
                </span>
                <button
                  type="button"
                  class="copy-btn"
                  data-copy-text={row.value}
                  aria-label={`复制${row.label}`}
                  title={`复制${row.label}`}
                  tabindex="0"
                >
                  <IconCopy class="copy-icon size-3.5" />
                  <svg
                    class="copy-check size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </li>
            ))
          }
          {
            emailValue && (
              <li class="info-row">
                <span class="info-row-label">邮箱</span>
                <span class="info-value inline-flex min-w-0 flex-1 items-center gap-1.5 truncate text-foreground/70">
                  <IconMail class="size-3.5 shrink-0" />
                  <span class="truncate">{emailValue}</span>
                </span>
                <button
                  type="button"
                  class="copy-btn"
                  data-copy-text={emailValue}
                  aria-label={`复制邮箱 ${emailValue}`}
                  title={`复制邮箱 ${emailValue}`}
                  tabindex="0"
                >
                  <IconCopy class="copy-icon size-3.5" />
                  <svg
                    class="copy-check size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </li>
            )
          }
          <li class="info-row">
            <span class="info-row-label">RSS</span>
            <span
              class="info-value inline-flex min-w-0 flex-1 items-center gap-1.5 truncate text-foreground/70"
            >
              <IconRss class="size-3.5 shrink-0" />
              <span class="truncate">{rssUrl}</span>
            </span>
            <button
              type="button"
              class="copy-btn"
              data-copy-text={rssUrl}
              aria-label="复制 RSS 链接"
              title="复制 RSS 链接"
              tabindex="0"
            >
              <IconCopy class="copy-icon size-3.5" />
              <svg
                class="copy-check size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </button>
          </li>
        </ul>

        <button
          type="button"
          class="fill-btn"
          data-app-fill
          aria-label="一键填充申请内容"
        >
          <svg
            class="size-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          一键填充申请内容
        </button>
        <p class="fill-hint">
          点击下方按钮，将本站信息复制到剪贴板。然后在评论区粘贴提交即可。
        </p>
      </div>
    </section>

    <!-- 评论区（友链申请渠道） -->
    <Comments />
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ applicationText }}>
  let friendsCleanup = null;

  // 轻量 Toast（页面底部居中出现，自动消失）
  function showToast(message) {
    document.querySelectorAll("[data-toast]").forEach(el => el.remove());
    const toast = document.createElement("div");
    toast.dataset.toast = "true";
    toast.textContent = message;
    document.body.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add("is-visible"));
    setTimeout(() => {
      toast.classList.remove("is-visible");
      setTimeout(() => toast.remove(), 300);
    }, 2400);
  }

  const copyText = async text => {
    try {
      if (!navigator.clipboard || !window.isSecureContext) {
        return false;
      }
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  function initFriendsPage() {
    if (friendsCleanup) friendsCleanup.abort();
    friendsCleanup = new AbortController();
    const { signal } = friendsCleanup;

    // Hero mouse glow
    const hero = document.querySelector("[data-friends-hero]");
    const heroMouse = document.querySelector("[data-friends-mouse]");
    if (hero && heroMouse) {
      hero.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            heroMouse.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            heroMouse.style.setProperty("--my", `${e.clientY - rect.top}px`);
            heroMouse.style.opacity = "1";
          });
        },
        { signal }
      );
      hero.addEventListener(
        "mouseleave",
        () => {
          heroMouse.style.opacity = "0";
        },
        { signal }
      );
    }

    const feedbackMs = 1600;

    // Copy buttons（复制成功短暂显示勾选状态）
    document.querySelectorAll("[data-copy-text]").forEach(button => {
      button.addEventListener(
        "click",
        async () => {
          const text = button.dataset.copyText ?? "";
          const ok = await copyText(text);
          if (!ok) {
            showToast("复制失败，请手动复制该信息");
            return;
          }
          button.classList.add("is-copied");
          setTimeout(() => button.classList.remove("is-copied"), feedbackMs);
        },
        { signal }
      );
    });

    // 一键填充申请内容：复制 + 滚动到评论区 + Toast
    const fillBtn = document.querySelector("[data-app-fill]");
    if (fillBtn) {
      fillBtn.addEventListener(
        "click",
        async () => {
          const ok = await copyText(applicationText || "");
          if (!ok) {
            showToast("复制失败，请手动复制本站信息");
            return;
          }
          const comments = document.getElementById("comments");
          if (comments) {
            comments.scrollIntoView({ behavior: "smooth", block: "start" });
          }
          fillBtn.classList.add("is-copied");
          setTimeout(() => fillBtn.classList.remove("is-copied"), 1600);
          showToast("申请内容已复制，请在评论区粘贴提交");
        },
        { signal }
      );
    }
  }

  // 幂等防重复（View Transitions 兼容）
  if (!window.__friendsBound) {
    window.__friendsBound = true;
    document.addEventListener("astro:page-load", initFriendsPage);
    document.addEventListener("DOMContentLoaded", initFriendsPage);
    if (document.readyState !== "loading") initFriendsPage();
  }
</script>

<style>
  .friends-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    margin-bottom: 2rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  @media (min-width: 640px) {
    .friends-hero {
      padding: 3rem;
    }
  }

  /* Info panels */
  .info-panel {
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    background: color-mix(in srgb, var(--muted) 8%, transparent);
    backdrop-filter: blur(12px);
    padding: 1.5rem 1.75rem;
  }

  .info-panel-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  .info-panel-heading h2 {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .info-list li {
    margin: 0;
  }

  /* ── 个人名片 Header ── */
  .info-profile {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.25rem 0 1.1rem;
  }

  .info-avatar {
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    object-fit: cover;
  }

  .info-profile p:first-child {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* 淡分隔线：Header 与信息区之间 */
  .info-divider {
    height: 1px;
    margin: 0 0 1.1rem;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--border) 25%, transparent),
      transparent
    );
  }

  /* ── 本站信息行 ── */
  .info-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.35rem 0.4rem;
    margin: 0 -0.4rem;
    border-radius: 0.5rem;
    transition: background-color 0.15s ease;
  }

  .info-row:hover {
    background: color-mix(in srgb, var(--muted) 12%, transparent);
  }

  .info-row-label {
    flex-shrink: 0;
    width: 3.25rem;
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.5;
  }

  /* 本站信息字段值・字号调小 */
  .info-value {
    font-size: 0.78rem;
    color: var(--color-foreground);
    opacity: 0.7;
    min-width: 0;
  }

  /* ── 复制按钮：默认隐藏，行 hover 时显现 ── */
  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    color: var(--accent);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateX(2px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease,
      visibility 0.18s;
  }

  .info-row:hover .copy-btn,
  .info-row:focus-within .copy-btn {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .copy-btn:hover {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .copy-btn .copy-check {
    display: none;
  }

  .copy-btn.is-copied .copy-icon {
    display: none;
  }

  .copy-btn.is-copied .copy-check {
    display: inline-block;
  }

  /* ── 友链须知条目 ── */
  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-foreground);
  }

  .info-item-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-item-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
  }

  .info-item-text {
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--color-foreground);
    opacity: 0.62;
  }

  .info-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.05rem;
    border-radius: 9999px;
    font-family: var(--font-firacode);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  /* ── 一键填充申请内容按钮（主操作） ── */
  .fill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    margin-top: 1.1rem;
    padding: 0.6rem 1.2rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .fill-btn:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    transform: translateY(-1px);
  }

  .fill-btn.is-copied {
    border-color: color-mix(in srgb, var(--accent) 65%, transparent);
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .fill-hint {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.72rem;
    line-height: 1.8;
    color: var(--color-foreground);
    opacity: 0.45;
  }

  /* Toast（一键填充反馈）— :global 使样式能应用到 JS 动态创建的节点 */
  :global([data-toast]) {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: 90;
    transform: translate(-50%, 1rem);
    max-width: min(90vw, 24rem);
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    background: color-mix(in srgb, var(--background) 78%, transparent);
    backdrop-filter: blur(12px);
    font-size: 0.82rem;
    color: var(--color-foreground);
    box-shadow: 0 10px 30px -10px
      color-mix(in srgb, var(--accent) 40%, transparent);
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    pointer-events: none;
  }

  :global([data-toast].is-visible) {
    opacity: 1;
    transform: translate(-50%, 0);
