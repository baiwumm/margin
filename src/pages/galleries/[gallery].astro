---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import Comments from "@/components/Comments.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

export async function getStaticPaths() {
  if (!SITE.showGalleries) return [];

  const slugOf = (id: string) =>
    id.replace(/\/index\.(md|mdx)$/, "").replace(/\.(md|mdx)$/, "");

  const galleries = await getCollection("galleries", ({ data }) => !data.draft);
  const sorted = [...galleries].sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  );

  return sorted.map((gallery, idx) => ({
    params: { gallery: slugOf(gallery.id) },
    props: {
      entry: gallery,
      prevGallery: idx < sorted.length - 1 ? sorted[idx + 1] : null,
      nextGallery: idx > 0 ? sorted[idx - 1] : null,
      prevPath:
        idx < sorted.length - 1
          ? `/galleries/${slugOf(sorted[idx + 1].id)}`
          : null,
      nextPath: idx > 0 ? `/galleries/${slugOf(sorted[idx - 1].id)}` : null,
    },
  }));
}

const { entry, prevGallery, nextGallery, prevPath, nextPath } = Astro.props;
const { gallery: slug } = Astro.params;
const { title, description, pubDatetime, coverImage, tags } = entry.data;

// Load all gallery images at build-time with a static glob
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

type GalleryImage = { src: ImageMetadata; alt: string; filename: string };

function filenameToAlt(filename: string): string {
  return (
    filename
      .replace(/\.[^.]+$/, "") // remove extension
      .replace(/^\d+[-_]?/, "") // remove initial number
      .replace(/[-_]/g, " ") // dashes/underscores → spaces
      .replace(/\b\w/g, c => c.toUpperCase()) // capitalize
      .trim() || title
  );
}

const images: GalleryImage[] = Object.entries(allImages)
  .filter(
    ([path]) =>
      path.startsWith(`/src/data/galleries/${slug}/`) && !path.includes("index")
  )
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split("/").pop() ?? "";
    return { src: mod.default, alt: filenameToAlt(filename), filename };
  });

// If the frontmatter has coverImage, include it at the beginning if it is not already in the list
const hasCoverInFolder = coverImage
  ? images.some(img => img.src.src === coverImage.src)
  : false;

const coverImageSrc = coverImage
  ? new URL(coverImage.src, Astro.url.origin).href
  : images.length > 0
    ? new URL(images[0].src.src, Astro.url.origin).href
    : undefined;

// Build Schema.org ImageGallery Structured Data
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: description,
  url: new URL(Astro.url.pathname, SITE.website).toString(),
  ...(coverImageSrc && { image: coverImageSrc }),
  creator: {
    "@type": "Person",
    name: SITE.author,
    ...(SITE.profile && { url: SITE.profile }),
  },
  numberOfItems: images.length,
};
---

<Layout
  title={`${title} | 画廊 | ${SITE.title}`}
  description={description}
  structuredData={gallerySchema}
>
  <Header />
  {SITE.showBackButton && <Breadcrumb withBackButton />}
  <main
    id="main-content"
    class:list={["relative app-layout pb-16", { "mt-8": !SITE.showBackButton }]}
  >
    <!-- Gallery header -->
    <header class="relative mb-10 text-center">
      <div class="gallery-hero-bg"></div>
      <div
        class="relative z-10 rounded-3xl border border-border/20 bg-muted/5 px-6 py-8 backdrop-blur-md sm:px-10 sm:py-12"
      >
        <h1
          transition:name={slugifyStr(String(title).replaceAll(".", "-"))}
          class="post-title text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-[2.75rem]"
        >
          {title}
        </h1>

        {
          description && (
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-foreground/60">
              {description}
            </p>
          )
        }

        <!-- Tags as badges -->
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          {
            tags.map(tag => (
              <a
                href={`/tags/${slugifyStr(tag)}/`}
                class="inline-flex items-center gap-1 rounded-full border border-accent/20 bg-accent/5 px-2.5 py-0.5 text-xs text-accent transition-all duration-200 hover:border-accent/40 hover:bg-accent/10 hover:shadow-sm hover:shadow-accent/10"
              >
                <span class="opacity-50">#</span>
                {tag}
              </a>
            ))
          }
        </div>

        <!-- Metadata row -->
        <div
          class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm"
        >
          <!-- Author chip -->
          <div class="inline-flex items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 backdrop-blur-sm">
            <svg
              class="size-3.5 text-accent/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span class="opacity-70">{SITE.author}</span>
          </div>

          <!-- Date chip -->
          <div class="inline-flex items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 backdrop-blur-sm">
            <svg
              class="size-3.5 text-accent/70"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <Datetime
              pubDatetime={pubDatetime}
              size="sm"
              class="opacity-70 [&>svg]:hidden"
            />
          </div>

          <!-- Gallery images count chip -->
          <div class="inline-flex items-center gap-1.5 rounded-lg border border-border/25 bg-muted/10 px-2.5 py-1 backdrop-blur-sm">
            <IconGallery class="size-3.5 text-accent/70" />
            <span
              class="opacity-70"
            >
              {images.length}张图片
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Large cover (if defined in frontmatter and not in the folder) -->
    {
      coverImage && !hasCoverInFolder && (
        <div class="mb-8 overflow-hidden rounded-2xl">
          <Image
            src={coverImage}
            alt={title}
            class="max-h-[60vh] w-full object-cover"
            loading="eager"
            widths={[800, 1200, 1600]}
            sizes="(max-width: 1200px) 100vw, 1200px"
          />
        </div>
      )
    }

    <!-- Image grid -->
    {
      images.length > 0 ? (
        <ul
          class="gallery-grid mt-6"
          id="gallery-grid"
          role="list"
          aria-label={`图片：${title}`}
        >
          {images.map((img, idx) => (
            <li>
              <button
                class="gallery-item group"
                data-index={idx}
                aria-label={`查看图片：${img.alt}`}
                type="button"
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  class="gallery-img"
                  loading={idx < 6 ? "eager" : "lazy"}
                  widths={[400, 800, 1600]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                />
                <div class="gallery-item-overlay">
                  <span class="gallery-item-alt">{img.alt}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 text-center text-foreground/50 italic">
          该画廊暂无图片。
        </p>
      )
    }

    <Comments />

    <!-- ═══════ Gallery footer section ═══════ -->
    <div
      class="post-end-divider relative mt-12 mb-8 flex items-center justify-center gap-4"
      aria-hidden="true"
    >
      <div
        class="relative h-px flex-1 bg-linear-to-r from-transparent via-border/30 to-accent/20"
      >
        <div
          class="absolute inset-0 bg-linear-to-r from-transparent via-accent/40 to-accent/40 blur-[2px]"
        >
        </div>
      </div>

      <div
        class="relative z-10 flex items-center gap-2 font-firacode text-[10px] tracking-widest text-accent/40 uppercase select-none"
      >
        <span
          class="h-1.5 w-1.5 rounded-full bg-accent/50 shadow-[0_0_8px_var(--color-accent)]"
        ></span>
        end
      </div>

      <div
        class="relative h-px flex-1 bg-linear-to-l from-transparent via-border/30 to-accent/20"
      >
        <div
          class="absolute inset-0 bg-linear-to-l from-transparent via-accent/40 to-accent/40 blur-[2px]"
        >
        </div>
      </div>
    </div>

    <!-- Previous/Next Gallery Navigation -->
    <div data-pagefind-ignore class="post-pagination grid grid-cols-2 gap-3">
      {
        prevGallery ? (
          <a
            href={prevPath}
            class="post-nav-link group relative flex flex-col gap-1 rounded-2xl border border-border/20 px-5 py-4 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
          >
            <div class="post-nav-bg" />
            <div class="flex items-center gap-1.5">
              <svg
                class="size-3.5 text-accent/50 transition-transform duration-300 group-hover:-translate-x-1 rtl:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
              </svg>
              <span class="font-firacode text-[10px] tracking-wider text-foreground/35 uppercase">
                Previous
              </span>
            </div>
            <span class="line-clamp-2 text-sm leading-snug font-medium text-foreground/70 transition-colors duration-200 group-hover:text-accent">
              {prevGallery.data.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextGallery && (
          <a
            href={nextPath}
            class="post-nav-link group relative col-start-2 flex flex-col items-end gap-1 rounded-2xl border border-border/20 px-5 py-4 text-end transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
          >
            <div class="post-nav-bg" />
            <div class="flex items-center gap-1.5">
              <span class="font-firacode text-[10px] tracking-wider text-foreground/35 uppercase">
                Next
              </span>
              <svg
                class="size-3.5 text-accent/50 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </div>
            <span class="line-clamp-2 text-sm leading-snug font-medium text-foreground/70 transition-colors duration-200 group-hover:text-accent">
              {nextGallery.data.title}
            </span>
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<!-- Lightbox dialog -->
<dialog
  id="lightbox"
  class="lightbox"
  aria-label="图片查看器"
  aria-modal="true"
>
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span id="lightbox-counter" class="lightbox-counter font-firacode"></span>
      <div class="lightbox-controls" role="toolbar" aria-label="预览工具栏">
        <button
          class="lightbox-btn lightbox-ctrl"
          id="lightbox-zoom-out"
          aria-label="缩小"
          title="缩小（-）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"
            ></line></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id="lightbox-zoom-in"
          aria-label="放大"
          title="放大（+）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"
            ></line><line x1="8" y1="11" x2="14" y2="11"></line></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id="lightbox-reset"
          aria-label="重置缩放"
          title="重置（0）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="9"></circle><circle
              cx="12"
              cy="12"
              r="4"></circle><circle cx="12" cy="12" r="0.5"></circle></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id="lightbox-rotate"
          aria-label="旋转 90 度"
          title="旋转（r）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path><polyline
              points="21 3 21 8 16 8"></polyline></svg
          >
        </button>
      </div>
      <button
        class="lightbox-btn"
        id="lightbox-close"
        aria-label="关闭"
        title="关闭（Esc）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>
    </div>

    <div class="lightbox-main">
      <button
        class="lightbox-btn lightbox-nav"
        id="lightbox-prev"
        aria-label="上一张"
        title="上一张（←）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
      </button>

      <div class="lightbox-figure">
        <div class="lightbox-stage" id="lightbox-stage">
          <img id="lightbox-img" src="" alt="" class="lightbox-image" />
        </div>
        <p id="lightbox-caption" class="lightbox-caption text-foreground/80">
        </p>
      </div>

      <button
        class="lightbox-btn lightbox-nav"
        id="lightbox-next"
        aria-label="下一张"
        title="下一张（→）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
    </div>
  </div>
</dialog>

<script>
  // Build image array from DOM
  function initGallery() {
    const grid = document.getElementById("gallery-grid");
    const lightbox = document.getElementById(
      "lightbox"
    ) as HTMLDialogElement | null;
    if (!grid || !lightbox) return;

    // From here TypeScript does not carry narrowing to closures; we use the local variable
    const lb = lightbox;

    const items = Array.from(
      grid.querySelectorAll<HTMLButtonElement>(".gallery-item")
    );
    const lightboxImg = document.getElementById(
      "lightbox-img"
    ) as HTMLImageElement;
    const lightboxCaption = document.getElementById(
      "lightbox-caption"
    ) as HTMLElement;
    const lightboxCounter = document.getElementById(
      "lightbox-counter"
    ) as HTMLElement;
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const zoomInBtn = document.getElementById("lightbox-zoom-in");
    const zoomOutBtn = document.getElementById("lightbox-zoom-out");
    const resetBtn = document.getElementById("lightbox-reset");
    const rotateBtn = document.getElementById("lightbox-rotate");

    // ── 缩放 / 旋转 / 平移状态 ──
    let scale = 1;
    let rotation = 0;
    let tx = 0;
    let ty = 0;
    const pointers = new Map<number, { x: number; y: number }>();
    let pinchStartDistance = 0;
    let pinchStartScale = 1;
    let panStart: { x: number; y: number; tx: number; ty: number } | null =
      null;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    function applyTransform(smooth = false) {
      lightboxImg.style.transition =
        smooth && !reduceMotion ? "transform 0.2s ease-out" : "none";
      lightboxImg.style.transform = `translate(${tx}px, ${ty}px) rotate(${rotation}deg) scale(${scale})`;
    }

    function resetTransform() {
      scale = 1;
      rotation = 0;
      tx = 0;
      ty = 0;
      lightboxImg.classList.remove("is-panning");
      applyTransform(true);
    }

    function setScrollLock(locked: boolean) {
      const docEl = document.documentElement;
      const body = document.body;
      if (locked) {
        docEl.style.overflow = "hidden";
        body.style.overflow = "hidden";
        body.style.overscrollBehavior = "none";
      } else {
        docEl.style.overflow = "";
        body.style.overflow = "";
        body.style.overscrollBehavior = "";
      }
    }

    function panRange() {
      const rect = lightboxImg.getBoundingClientRect();
      return {
        maxX: Math.max((rect.width - lb.clientWidth) / 2, 0) + 40,
        maxY: Math.max((rect.height - lb.clientHeight) / 2, 0) + 40,
      };
    }

    function zoomBy(factor: number) {
      const next = Math.min(4, Math.max(1, scale * factor));
      if (next === 1) {
        tx = 0;
        ty = 0;
      }
      scale = next;
      applyTransform(true);
    }

    let current = 0;
    let openSeq = 0;
    const lightboxStage = document.getElementById(
      "lightbox-stage"
    ) as HTMLElement | null;
    const preloadCache = new Set<string>();

    lightboxStage?.addEventListener("animationend", () => {
      lightboxStage.classList.remove("slide-in-left", "slide-in-right");
    });

    // 从 srcset 中取最大尺寸的版本，保证灯箱放大后清晰
    function pickLargestSrc(el: HTMLImageElement): string {
      const srcset = el.srcset;
      if (!srcset) return el.src;
      let best = "";
      let bestW = 0;
      for (const part of srcset.split(",")) {
        const pieces = part.trim().split(/\s+/);
        const w = pieces[1]?.endsWith("w") ? parseInt(pieces[1], 10) : 0;
        if (w > bestW) {
          bestW = w;
          best = pieces[0];
        }
      }
      return best || el.src;
    }

    // 预加载相邻图片，切换时无需等待网络
    function preloadImage(url: string) {
      if (!url || preloadCache.has(url)) return;
      preloadCache.add(url);
      const pre = new Image();
      pre.src = url;
    }

    async function open(idx: number) {
      const seq = ++openSeq;
      const direction = idx > current ? 1 : idx < current ? -1 : 0;
      current = Math.max(0, Math.min(idx, items.length - 1));
      const btn = items[current];
      const img = btn.querySelector("img");
      if (!img) return;

      const largeSrc = pickLargestSrc(img);
      lightboxImg.src = largeSrc;
      lightboxImg.alt = img.alt;

      // 预加载相邻图片
      for (const neighbor of [current - 1, current + 1]) {
        const nb = items[neighbor]?.querySelector("img");
        if (nb) preloadImage(pickLargestSrc(nb));
      }

      // 等新图解码完成再一起更新文案并播放动画，避免“先显示 Alt”
      if (!reduceMotion && direction !== 0) {
        try {
          await lightboxImg.decode();
        } catch {
          // 解码失败时直接显示
        }
      }
      if (seq !== openSeq) return;

      lightboxCaption.textContent = img.alt;
      lightboxCounter.textContent = `${current + 1} / ${items.length}`;
      resetTransform();

      if (!reduceMotion && lightboxStage && direction !== 0) {
        lightboxStage.classList.remove("slide-in-left", "slide-in-right");
        void lightboxStage.offsetWidth; // 强制回流，保证动画可重复触发
        lightboxStage.classList.add(
          direction > 0 ? "slide-in-right" : "slide-in-left"
        );
      }

      if (prevBtn)
        prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
      if (nextBtn)
        nextBtn.style.visibility =
          current === items.length - 1 ? "hidden" : "visible";

      lb.showModal();
      setScrollLock(true);
    }

    function close() {
      lb.close();
      setScrollLock(false);
    }

    items.forEach((btn, idx) => {
      btn.addEventListener("click", () => open(idx));
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => open(current - 1));
    nextBtn?.addEventListener("click", () => open(current + 1));
    zoomInBtn?.addEventListener("click", () => zoomBy(1.5));
    zoomOutBtn?.addEventListener("click", () => zoomBy(1 / 1.5));
    resetBtn?.addEventListener("click", resetTransform);
    rotateBtn?.addEventListener("click", () => {
      rotation = (rotation + 90) % 360;
      applyTransform(true);
    });

    // 滚轮缩放
    lightboxImg.addEventListener(
      "wheel",
      e => {
        e.preventDefault();
        zoomBy(e.deltaY < 0 ? 1.15 : 1 / 1.15);
      },
      { passive: false }
    );

    // 双指缩放 + 拖拽平移
    lightboxImg.addEventListener("pointerdown", e => {
      lightboxImg.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      lightboxImg.style.transition = "none";
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchStartDistance = Math.hypot(a.x - b.x, a.y - b.y);
        pinchStartScale = scale;
        panStart = null;
      } else if (pointers.size === 1 && scale > 1) {
        panStart = { x: e.clientX, y: e.clientY, tx, ty };
        lightboxImg.classList.add("is-panning");
      }
    });
    lightboxImg.addEventListener("pointermove", e => {
      const prev = pointers.get(e.pointerId);
      if (!prev) return;
      if (pointers.size === 2) {
        const other = [...pointers.entries()].find(
          ([id]) => id !== e.pointerId
        );
        if (other && pinchStartDistance > 0) {
          const [, a] = other;
          const dist = Math.hypot(a.x - e.clientX, a.y - e.clientY);
          const next = Math.min(
            4,
            Math.max(1, pinchStartScale * (dist / pinchStartDistance))
          );
          if (next === 1) {
            tx = 0;
            ty = 0;
          }
          scale = next;
          applyTransform(false);
        }
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      } else if (panStart) {
        const { maxX, maxY } = panRange();
        tx = Math.max(
          -maxX,
          Math.min(maxX, panStart.tx + (e.clientX - panStart.x))
        );
        ty = Math.max(
          -maxY,
          Math.min(maxY, panStart.ty + (e.clientY - panStart.y))
        );
        applyTransform(false);
      } else {
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      }
    });
    const endPointer = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      lightboxImg.classList.remove("is-panning");
      if (pointers.size < 2) pinchStartDistance = 0;
      if (pointers.size === 1) {
        const [, p] = [...pointers.entries()][0];
        panStart = scale > 1 ? { x: p.x, y: p.y, tx, ty } : null;
      } else if (pointers.size === 0) {
        panStart = null;
      }
    };
    lightboxImg.addEventListener("pointerup", endPointer);
    lightboxImg.addEventListener("pointercancel", endPointer);
    lightboxImg.addEventListener("lostpointercapture", endPointer);

    // 双击缩放 / 还原
    lightboxImg.addEventListener("dblclick", () => {
      if (scale > 1) {
        resetTransform();
      } else {
        scale = 2;
        applyTransform(true);
      }
    });

    document.addEventListener("keydown", e => {
      if (!lb.open) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") open(current - 1);
      if (e.key === "ArrowRight") open(current + 1);
      if (e.key === "+" || e.key === "=") zoomBy(1.25);
      if (e.key === "-" || e.key === "_") zoomBy(1 / 1.25);
      if (e.key === "0") resetTransform();
      if (e.key.toLowerCase() === "r") {
        rotation = (rotation + 90) % 360;
        applyTransform(true);
      }
    });
  }

  // Initialize on first load and SPA navigations (View Transitions)
  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>

