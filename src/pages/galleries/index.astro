---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EmptyState from "@/components/EmptyState.astro";
import GalleryCard from "@/components/GalleryCard.astro";
import { SITE } from "@/config";
import { getGallerySlug } from "@/utils/contentEntry";

if (!SITE.showGalleries) {
  return Astro.redirect("/404");
}

// Load all images from all galleries at build-time
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

// Get images from a specific gallery
function getGalleryImages(slug: string): ImageMetadata[] {
  return Object.entries(allImages)
    .filter(
      ([path]) =>
        path.startsWith(`/src/data/galleries/${slug}/`) &&
        !path.endsWith("index.md") &&
        !path.endsWith("index.mdx")
    )
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
}

const rawGalleries = await getCollection(
  "galleries",
  ({ data }) => !data.draft
);

const galleries = rawGalleries
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  )
  .map(gallery => {
    const slug = getGallerySlug(gallery.id);
    const folderImages = getGalleryImages(slug);
    return {
      gallery,
      slug,
      fallbackImage: folderImages[0],
      imageCount: folderImages.length,
    };
  });

const totalImages = galleries.reduce(
  (sum, { imageCount }) => sum + imageCount,
  0
);
---

<Layout title={`画廊 | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-8">
    <!-- Hero -->
    <div class="galleries-hero" data-galleries-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-galleries-mouse></div>
      <div class="relative z-10">
        <!-- Terminal prompt badge -->
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/40 bg-muted/20 px-3.5 py-1.5 font-firacode text-xs sm:text-sm"
        >
          <span class="text-accent">~</span>
          <span>/galleries</span>
          <span class="opacity-40">$</span>
          <span class="opacity-60">ls -la</span>
        </div>

        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">画廊</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          图片合集，记录瞬间与项目。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="hero-badge">{galleries.length} 个画廊</span>
          {
            totalImages > 0 && (
              <span class="hero-badge">{totalImages} 张图片</span>
            )
          }
        </div>
      </div>
    </div>

    <!-- Gallery grid -->
    {
      galleries.length === 0 ? (
        <EmptyState title="暂无画廊" description="敬请期待。" />
      ) : (
        <ul
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
        >
          {galleries.map(({ gallery, slug, fallbackImage, imageCount }) => (
            <li>
              <GalleryCard
                gallery={gallery}
                slug={slug}
                fallbackImage={fallbackImage}
                imageCount={imageCount}
              />
            </li>
          ))}
        </ul>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  let galleriesCleanup: AbortController | null = null;

  document.addEventListener("astro:page-load", () => {
    // Cleanup previous listeners
    if (galleriesCleanup) galleriesCleanup.abort();
    galleriesCleanup = new AbortController();
    const { signal } = galleriesCleanup;

    // Hero mouse-follow aurora
    const hero = document.querySelector("[data-galleries-hero]") as HTMLElement;
    const heroMouse = document.querySelector(
      "[data-galleries-mouse]"
    ) as HTMLElement;
    if (hero && heroMouse) {
      hero.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            heroMouse.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            heroMouse.style.setProperty("--my", `${e.clientY - rect.top}px`);
            heroMouse.style.opacity = "1";
          });
        },
        { signal }
      );
      hero.addEventListener(
        "mouseleave",
        () => {
          heroMouse.style.opacity = "0";
        },
        { signal }
      );
    }
  });
</script>

<style>
  /* ===== Hero ===== */
  .galleries-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    margin-bottom: 2rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  @media (min-width: 640px) {
    .galleries-hero {
      padding: 3rem;
    }
  }
</style>
