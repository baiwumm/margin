---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [blogPosts, galleryPosts] = await Promise.all([
    getCollection("blog"),
    SITE.showGalleries && SITE.showGalleriesInIndex
      ? getCollection("galleries")
      : Promise.resolve([]),
  ]);
  const posts = [...blogPosts, ...galleryPosts];
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;

const tagOgImage = `/tags/${tag}/og.png`;

const metaTitle =
  page.currentPage > 1
    ? `${tagName}（第 ${page.currentPage} 页，共 ${page.lastPage} 页）| 标签 | ${SITE.title}`
    : `${tagName} | 标签 | ${SITE.title}`;

const tagDescription =
  page.currentPage > 1
    ? `浏览标签「${tagName}」下的全部内容（第 ${page.currentPage} 页，共 ${page.lastPage} 页）。`
    : `浏览标签「${tagName}」下的全部内容。`;

const prevURL = page.url.prev
  ? new URL(page.url.prev, SITE.website).toString()
  : undefined;
const nextURL = page.url.next
  ? new URL(page.url.next, SITE.website).toString()
  : undefined;
---

<Layout
  title={metaTitle}
  description={tagDescription}
  ogImage={tagOgImage}
  prev={prevURL}
  next={nextURL}
>
  <Header />
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`包含标签「${tagName}」的全部内容。`}
  >
    <ul
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 [&>li]:my-0"
    >
      {
        page.data.map((data, index) => (
          <Card
            {...data}
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index < 3 ? "high" : "auto"}
          />
        ))
      }
    </ul>

    <Pagination {page} />
  </Main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
