---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import EmptyState from "@/components/EmptyState.astro";
import Pagination from "@/components/Pagination.astro";
import "@pagefind/default-ui/css/ui.css";
import type { ContentEntry } from "@/utils/contentEntry";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const [blogPosts, galleryPosts] = await Promise.all([
    getCollection("blog", ({ data }) => !data.draft),
    SITE.showGalleries && SITE.showGalleriesInIndex
      ? getCollection("galleries", ({ data }) => !data.draft)
      : Promise.resolve([]),
  ]);
  return paginate(getSortedPosts([...blogPosts, ...galleryPosts]), {
    pageSize: SITE.postPerPage,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const totalPosts = page.total;

// Prevent duplicate metadata in pagination
const metaTitle =
  page.currentPage > 1
    ? `Posts（第 ${page.currentPage} 页，共 ${page.lastPage} 页）| ${SITE.title}`
    : `Posts | ${SITE.title}`;

const metaDesc =
  page.currentPage > 1
    ? `浏览我发布的全部文章（第 ${page.currentPage} 页，共 ${page.lastPage} 页）。`
    : `我发布过的全部文章。`;

const prevURL = page.url.prev
  ? new URL(page.url.prev, SITE.website).toString()
  : undefined;
const nextURL = page.url.next
  ? new URL(page.url.next, SITE.website).toString()
  : undefined;
---

<Layout title={metaTitle} description={metaDesc} prev={prevURL} next={nextURL}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-8">
    <!-- Hero -->
    <div class="posts-hero" data-posts-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-posts-mouse></div>
      <div class="relative z-10">
        <!-- Terminal prompt badge -->
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/40 bg-muted/20 px-3.5 py-1.5 font-firacode text-xs sm:text-sm"
        >
          <span class="text-accent">~</span>
          <span>/posts</span>
          <span class="opacity-40">$</span>
          <span class="opacity-60">ls -la</span>
        </div>

        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">Posts</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          我发布过的全部文章。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="hero-badge">{totalPosts} 篇文章</span>
          {
            page.lastPage > 1 && (
              <span class="hero-badge">
                第 {page.currentPage}/{page.lastPage} 页
              </span>
            )
          }
        </div>
      </div>
    </div>

    <!-- Posts Toolbar -->
    <div class="posts-toolbar mb-8">
      <div class="posts-search-wrapper">
        <div id="posts-pagefind" class="premium-search"></div>
      </div>
    </div>

    <!-- Posts Grid -->
    <div data-default-posts-container class="w-full">
      {
        page.data.length === 0 ? (
          <EmptyState
            title="还没有文章"
            description="稍后再来看看，这里会有新的文章。"
            icon='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="15" x2="15" y2="15" /></svg>'
          />
        ) : (
          <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 [&>li]:my-0">
            {page.data.map((data: ContentEntry, index) => (
              <Card
                {...data}
                loading={index < 3 ? "eager" : "lazy"}
                fetchpriority={index < 3 ? "high" : "auto"}
              />
            ))}
          </ul>
        )
      }

      <div data-pagination-wrapper class="[&>nav]:mb-0">
        <Pagination {page} />
      </div>
    </div>
  </main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<script>
  let cleanupController: AbortController | null = null;

  function initPostsPage() {
    if (cleanupController) cleanupController.abort();
    cleanupController = new AbortController();
    const { signal } = cleanupController;

    // Hero mouse glow
    const hero = document.querySelector("[data-posts-hero]") as HTMLElement;
    const heroMouse = document.querySelector(
      "[data-posts-mouse]"
    ) as HTMLElement;
    if (hero && heroMouse) {
      hero.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            heroMouse.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            heroMouse.style.setProperty("--my", `${e.clientY - rect.top}px`);
            heroMouse.style.opacity = "1";
          });
        },
        { signal }
      );
      hero.addEventListener(
        "mouseleave",
        () => {
          heroMouse.style.opacity = "0";
        },
        { signal }
      );
    }

    // Vim-style card navigation (j / k)
    const isTyping = () => {
      const el = document.activeElement;
      if (!el) return false;
      const tag = el.tagName;
      return (
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        (el as HTMLElement).isContentEditable
      );
    };

    const modalOpen = (selector: string) =>
      document.querySelector(selector)?.classList.contains("active") ?? false;

    const getCardLinks = () =>
      Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
          "[data-default-posts-container] li a[aria-labelledby]"
        )
      ).filter(el => el.offsetParent !== null);

    document.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if (isTyping()) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        // Do not hijack keys while a modal is open
        if (modalOpen(".shortcuts-overlay") || modalOpen("#search-modal")) {
          return;
        }
        if (e.key !== "j" && e.key !== "k") return;

        const links = getCardLinks();
        if (links.length === 0) return;

        e.preventDefault();
        const active = document.activeElement as HTMLElement | null;
        const current = active
          ? links.indexOf(active as HTMLAnchorElement)
          : -1;
        const next =
          e.key === "j"
            ? links[current < 0 ? 0 : Math.min(current + 1, links.length - 1)]
            : links[current < 0 ? links.length - 1 : Math.max(current - 1, 0)];
        next.focus();
        next.scrollIntoView({ block: "nearest" });
      },
      { signal }
    );

    // Initialize Pagefind local search
    const container = document.querySelector("#posts-pagefind");
    if (!container || container.childElementCount > 0) return;

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));
    onIdle(async () => {
      if (signal.aborted) return;
      if (container.childElementCount > 0) return;

      // @ts-expect-error PagefindUI does not export ESM compatible types in this dynamic import
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Navigation may have occurred while the module was loading (first load, uncached)
      if (signal.aborted || container.childElementCount > 0) return;

      if (import.meta.env.DEV) {
        container.innerHTML = `
          <div class="bg-muted/75 rounded p-4 text-sm mb-4 border border-border">
            <p><strong>Dev Mode:</strong> The search will attempt to use the latest built index. If you don't see results, run <code>pnpm run build</code> first.</p>
          </div>
        `;
        // Removed the early return to allow pagefind to attempt loading the local index
      }

      new PagefindUI({
        element: "#posts-pagefind",
        showImages: false,
        showSubResults: true,
      });

      // Toggle default posts grid visibility when typing
      const input = container.querySelector(
        ".pagefind-ui__search-input"
      ) as HTMLInputElement;
      const defaultContainer = document.querySelector(
        "[data-default-posts-container]"
      ) as HTMLElement;

      if (input && defaultContainer) {
        const toggleVisibility = () => {
          const hasValue = input.value.trim().length > 0;
          if (hasValue) {
            defaultContainer.style.display = "none";
          } else {
            defaultContainer.style.display = "";
          }
        };

        input.addEventListener("input", toggleVisibility, { signal });

        // Handle clear button
        const clearBtn = container.querySelector(".pagefind-ui__search-clear");
        if (clearBtn) {
          clearBtn.addEventListener(
            "click",
            () => {
              requestAnimationFrame(() => toggleVisibility());
            },
            { signal }
          );
        }
      }

      // Intercept Global Cmd+K / Ctrl+K to focus inline search instead of Modal
      const handleCmdK = (e: KeyboardEvent) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          e.stopPropagation();
          if (input) {
            input.focus();
            // Scroll to the search box if it's not visible
            input.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        }
      };

      // Use capture mode to intercept before the global modal listener
      document.addEventListener("keydown", handleCmdK, {
        signal,
        capture: true,
      });
    });
  }

  document.addEventListener("astro:page-load", initPostsPage);
</script>

<style>
  .posts-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    margin-bottom: 2rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  @media (min-width: 640px) {
    .posts-hero {
      padding: 3rem;
    }
  }

  /* Toolbar & Search Styles */
  .posts-toolbar {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
