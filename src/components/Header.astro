---
import IconDots from "@/assets/icons/IconDots.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconTag from "@/assets/icons/IconTag.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import Logo from "@/assets/logo/margin.svg";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  Skip to content
</a>

<header
  id="main-header"
  class="sticky top-0 z-40 w-full transition-colors duration-300"
>
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Logo -->
        <a
          href="/"
          class="group relative z-20 flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl"
        >
          <!-- <span class="nav-logo-text">{SITE.title}</span> -->
          <Logo class="h-9 w-auto sm:h-10" />
        </a>

        <!-- Center Audio Player -->
        {
          SITE.introAudio.enabled && (
            <div class="flex min-w-0 flex-1 justify-center">
              <IntroAudioCompact
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
                class="nav-intro-audio-compact"
              />
            </div>
          )
        }

        <!-- Nav area -->
        <nav
          id="nav-menu"
          class="relative flex shrink-0 items-center sm:gap-1.5"
        >
          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn sm:hidden"
            aria-label="Open Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on sm+) -->
          <ul class="hidden sm:flex sm:flex-row sm:items-center sm:gap-1.5">
            <li>
              <a
                href="/posts"
                class:list={["nav-link", { "nav-active": isActive("/posts") }]}
                >Posts</a
              >
            </li>
            <li>
              <a
                href="/about"
                class:list={["nav-link", { "nav-active": isActive("/about") }]}
                >About</a
              >
            </li>
            {
              SITE.showProjects && (
                <li>
                  <a
                    href="/projects"
                    class:list={[
                      "nav-link",
                      { "nav-active": isActive("/projects") },
                    ]}
                  >
                    Projects
                  </a>
                </li>
              )
            }
            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title="Search (⌘K)"
                aria-label="Open search"
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4.5" />
                <kbd class="nav-kbd" data-search-kbd>⌘K</kbd>
              </button>
            </li>
            <li class="flex items-center">
              <button
                id="menu-more-btn"
                class="nav-more-btn"
                title="Menu"
                aria-label="Open menu"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="more-menu"
              >
                <IconDots class="size-5" />
              </button>
            </li>
          </ul>

          <!-- More dropdown panel -->
          <div id="more-menu" class="more-menu" aria-hidden="true">
            <div class="more-menu-panel">
              <div class="menu-section">
                <span class="menu-section-label">Explore</span>
                <a
                  href="/tags"
                  class:list={[
                    "menu-row",
                    { "menu-active": isActive("/tags") },
                  ]}
                >
                  <IconTag class="menu-row-icon" />
                  <span>Tags</span>
                </a>
                {
                  SITE.showArchives && (
                    <a
                      href="/archives"
                      class:list={[
                        "menu-row",
                        { "menu-active": isActive("/archives") },
                      ]}
                    >
                      <IconArchive class="menu-row-icon" />
                      <span>Archives</span>
                    </a>
                  )
                }
                {
                  SITE.showGalleries && (
                    <a
                      href="/galleries"
                      class:list={[
                        "menu-row",
                        { "menu-active": isActive("/galleries") },
                      ]}
                    >
                      <IconGallery class="menu-row-icon" />
                      <span>Galleries</span>
                    </a>
                  )
                }
                {
                  SITE.showMoments && (
                    <a
                      href="/moments"
                      class:list={[
                        "menu-row",
                        { "menu-active": isActive("/moments") },
                      ]}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="menu-row-icon"
                        aria-hidden="true"
                      >
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                      </svg>
                      <span>Moments</span>
                    </a>
                  )
                }
              </div>

              <div class="menu-divider"></div>

              {
                SITE.lightAndDarkMode && (
                  <div class="menu-section">
                    <span class="menu-section-label">Preferences</span>
                    <div class="menu-row menu-row-between">
                      <span>Theme</span>
                      <div
                        class="theme-segment"
                        role="group"
                        aria-label="Theme"
                      >
                        <button
                          type="button"
                          data-theme-option="light"
                          aria-pressed="false"
                          aria-label="Light mode"
                          title="Light"
                        >
                          <IconSunHigh class="size-4" />
                        </button>
                        <button
                          type="button"
                          data-theme-option="dark"
                          aria-pressed="false"
                          aria-label="Dark mode"
                          title="Dark"
                        >
                          <IconMoon class="size-4" />
                        </button>
                      </div>
                    </div>
                    <div class="menu-row menu-row-between">
                      <span>Accent Color</span>
                      <div
                        class="accent-dots"
                        role="group"
                        aria-label="Accent color"
                      >
                        <button
                          type="button"
                          class="accent-dot"
                          data-accent-option="blue"
                          style="background: var(--accent-blue)"
                          aria-label="Blue"
                          aria-pressed="false"
                          title="Blue"
                        />
                        <button
                          type="button"
                          class="accent-dot"
                          data-accent-option="green"
                          style="background: var(--accent-green)"
                          aria-label="Green"
                          aria-pressed="false"
                          title="Green"
                        />
                        <button
                          type="button"
                          class="accent-dot"
                          data-accent-option="purple"
                          style="background: var(--accent-purple)"
                          aria-label="Purple"
                          aria-pressed="false"
                          title="Purple"
                        />
                        <button
                          type="button"
                          class="accent-dot"
                          data-accent-option="orange"
                          style="background: var(--accent-orange)"
                          aria-label="Orange"
                          aria-pressed="false"
                          title="Orange"
                        />
                        <button
                          type="button"
                          class="accent-dot"
                          data-accent-option="rose"
                          style="background: var(--accent-rose)"
                          aria-label="Rose"
                          aria-pressed="false"
                          title="Rose"
                        />
                      </div>
                    </div>
                  </div>
                )
              }

              <div class="menu-divider"></div>

              <div class="menu-section">
                <span class="menu-section-label">Help</span>
                <button
                  type="button"
                  class="menu-row menu-row-between menu-row-btn"
                  data-shortcuts-trigger
                >
                  <span class="menu-row-start">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="menu-row-icon"
                      aria-hidden="true"
                    >
                      <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                      <path
                        d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01M9 14h6"
                      ></path>
                    </svg>
                    <span>Shortcuts</span>
                  </span>
                  <kbd class="nav-kbd">?</kbd>
                </button>
              </div>
            </div>
          </div>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent opacity-0 transition-opacity duration-300"
  >
  </div>
</header>

<style>
  /* ─── Header Glass & Scroll Physics ─── */
  #main-header {
    background: transparent;
  }

  :global(.header-scrolled) {
    background: color-mix(
      in srgb,
      var(--background) 80%,
      transparent
    ) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
  }

  :global(.header-scrolled .header-scrolled-filter) {
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  .nav-logo-text {
    background: linear-gradient(
      135deg,
      var(--foreground) 0%,
      var(--foreground) 60%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global(.nav-intro-audio-compact) {
    max-width: 100%;
  }

  /* ─── Desktop nav links ─── */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.5rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link:focus-visible,
  .nav-search-btn:focus-visible,
  .nav-more-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .nav-link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-active {
    color: var(--accent);
    /* Clean active state for desktop */
    background: transparent;
  }

  /* Glowing dot for active state (macOS Dock style) */
  .nav-active::after {
    content: "";
    position: absolute;
    bottom: -0.1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  /* ─── Desktop Search Button with ⌘K ─── */
  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem 0.3rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--foreground) 75%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-green) 25%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--accent-green) 12%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-search-btn:hover {
    color: var(--foreground);
    border-color: color-mix(in srgb, var(--accent-green) 45%, transparent);
    background: color-mix(in srgb, var(--accent-green) 18%, transparent);
  }

  .nav-kbd {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-bottom-width: 2px;
    background: color-mix(in srgb, var(--background) 90%, transparent);
    color: var(--muted-foreground);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.1);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-search-btn:hover .nav-kbd {
    border-color: color-mix(in srgb, var(--accent-green) 45%, transparent);
    color: var(--accent);
  }

  /* ─── More Menu Button (…) ─── */
  .nav-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-more-btn:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-more-btn[aria-expanded="true"] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  /* ─── More Menu Dropdown Panel ─── */
  .more-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    z-index: 50;
    pointer-events: none;
  }

  .more-menu.is-open {
    pointer-events: auto;
  }

  .more-menu-panel {
    width: 17rem;
    padding: 0.375rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    background: color-mix(in srgb, var(--background) 85%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s;
    visibility: hidden;
  }

  .more-menu.is-open .more-menu-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  .menu-section {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.25rem;
  }

  .menu-section-label {
    padding: 0.375rem 0.625rem 0.25rem;
    font-family: var(--font-firacode), monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .menu-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .menu-row:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .menu-row.menu-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .menu-row-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .menu-row-btn {
    width: 100%;
    border: none;
    background: transparent;
    font-family: inherit;
    text-align: start;
    cursor: pointer;
  }

  .menu-row-start {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .menu-row-between {
    justify-content: space-between;
  }

  .menu-divider {
    height: 1px;
    margin: 0.375rem 0.375rem;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--border) 35%, transparent),
      transparent
    );
  }

  /* ─── Animated Hamburger Button ─── */
  .hamburger-btn {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    border: 1px solid transparent;
    background: transparent;
    transition:
      background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-btn:hover,
  .hamburger-btn[aria-expanded="true"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .hamburger-box {
    position: relative;
    width: 18px;
    height: 14px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--foreground);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger-line--1 {
    top: 0;
  }
  .hamburger-line--2 {
    top: 6px;
  }
  .hamburger-line--3 {
    top: 12px;
    width: 60%;
  }

  /* Open state: morph to X */
  .hamburger-btn[aria-expanded="true"] .hamburger-line {
    background: var(--accent);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--1 {
    top: 6px;
    transform: rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--3 {
    top: 6px;
    width: 100%;
    transform: rotate(-45deg);
  }
</style>

<script>
  let headerCleanup: AbortController | null = null;
  let scrollCleanup: AbortController | null = null;
  let moreMenuCleanup: AbortController | null = null;

  function setupScrollPhysics() {
    if (scrollCleanup) scrollCleanup.abort();
    scrollCleanup = new AbortController();
    const { signal } = scrollCleanup;

    const header = document.getElementById("main-header");
    const navWrap = document.getElementById("top-nav-wrap");
    const borderLine = document.getElementById("header-border");

    if (!header || !navWrap || !borderLine) return;

    let rafPending = false;
    let scrolled = false;
    // Hysteresis around the threshold: activate only after scrolling past
    // ACTIVATE, and only deactivate after returning below DEACTIVATE.
    // This prevents the header height change from flipping the state back
    // and forth near the boundary (visible as jitter while the header sticks).
    const ACTIVATE_SCROLL_Y = 16;
    const DEACTIVATE_SCROLL_Y = 8;
    const handleScroll = () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        const nextScrolled = scrolled
          ? window.scrollY > DEACTIVATE_SCROLL_Y
          : window.scrollY > ACTIVATE_SCROLL_Y;
        if (nextScrolled !== scrolled) {
          scrolled = nextScrolled;
          header.classList.toggle("header-scrolled", scrolled);
          navWrap.classList.toggle("sm:py-5", !scrolled);
          navWrap.classList.toggle("sm:py-3", scrolled);
          borderLine.classList.toggle("opacity-0", !scrolled);
          borderLine.classList.toggle("opacity-100", scrolled);
        }
        rafPending = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true, signal });
    handleScroll(); // Init instantly
  }

  function setupMobileNav() {
    // Cleanup previous listeners
    if (headerCleanup) headerCleanup.abort();
    headerCleanup = new AbortController();
    const { signal } = headerCleanup;

    const menuBtn = document.querySelector("#menu-btn");
    const mobileMenu = document.querySelector("#mobile-menu");
    const backdrop = document.querySelector(".mobile-menu-backdrop");

    if (!menuBtn || !mobileMenu) return;

    const closeMenu = () => {
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "Open Menu");
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
    };

    menuBtn.addEventListener(
      "click",
      () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          closeMenu();
        } else {
          menuBtn.setAttribute("aria-expanded", "true");
          menuBtn.setAttribute("aria-label", "Close Menu");
          mobileMenu.classList.add("is-open");
          mobileMenu.setAttribute("aria-hidden", "false");
        }
      },
      { signal }
    );

    // Close when clicking the backdrop
    if (backdrop) {
      backdrop.addEventListener("click", closeMenu, { signal });
      window.addEventListener("scroll", closeMenu, { passive: true, signal });
    }

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu, { signal });
    });
  }

  function setupMoreMenu() {
    if (moreMenuCleanup) moreMenuCleanup.abort();
    moreMenuCleanup = new AbortController();
    const { signal } = moreMenuCleanup;

    const moreBtn = document.querySelector<HTMLButtonElement>("#menu-more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreBtn || !moreMenu) return;

    const getFocusable = () =>
      Array.from(
        moreMenu.querySelectorAll<HTMLElement>(
          "a[href], button:not([disabled])"
        )
      ).filter(el => el.offsetParent !== null);

    const closeMoreMenu = (returnFocus = false) => {
      moreBtn.setAttribute("aria-expanded", "false");
      moreBtn.setAttribute("aria-label", "Open menu");
      moreMenu.classList.remove("is-open");
      moreMenu.setAttribute("aria-hidden", "true");
      if (returnFocus) moreBtn.focus();
    };

    moreBtn.addEventListener(
      "click",
      () => {
        const isOpen = moreBtn.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          closeMoreMenu();
        } else {
          moreBtn.setAttribute("aria-expanded", "true");
          moreBtn.setAttribute("aria-label", "Close menu");
          moreMenu.classList.add("is-open");
          moreMenu.setAttribute("aria-hidden", "false");
          // Move focus into the panel for keyboard users
          getFocusable()[0]?.focus();
        }
      },
      { signal }
    );

    // Close on outside click
    document.addEventListener(
      "click",
      event => {
        if (moreBtn.getAttribute("aria-expanded") !== "true") return;
        const target = event.target as Node;
        if (moreBtn.contains(target) || moreMenu.contains(target)) return;
        closeMoreMenu();
      },
      { signal }
    );

    // Escape closes and returns focus; arrows move between panel items
    document.addEventListener(
      "keydown",
      event => {
        if (event.key === "Escape") {
          if (moreBtn.getAttribute("aria-expanded") === "true") {
            event.preventDefault();
            closeMoreMenu(true);
          }
          return;
        }
        if (moreBtn.getAttribute("aria-expanded") !== "true") return;
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
        const items = getFocusable();
        if (!items.length) return;
        const current = document.activeElement as HTMLElement | null;
        const index = current ? items.indexOf(current) : -1;
        const next =
          event.key === "ArrowDown"
            ? (index + 1) % items.length
            : (index - 1 + items.length) % items.length;
        event.preventDefault();
        items[next].focus();
      },
      { signal }
    );

    // Close when navigating via a menu link
    moreMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => closeMoreMenu(), { signal });
    });

    // Close when opening the shortcuts panel from the menu
    moreMenu.querySelectorAll("[data-shortcuts-trigger]").forEach(btn => {
      btn.addEventListener("click", () => closeMoreMenu(), { signal });
    });
  }

  function setupSearchKbd() {
    const isMac = /Mac|iPhone|iPad|iPod/i.test(
      navigator.platform || navigator.userAgent
    );
    document.querySelectorAll("[data-search-kbd]").forEach(el => {
      el.textContent = isMac ? "⌘K" : "Ctrl K";
    });
  }

  // Initial load
  setupScrollPhysics();
  setupMobileNav();
  setupMoreMenu();
  setupSearchKbd();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    setupScrollPhysics();
    setupMobileNav();
    setupMoreMenu();
    setupSearchKbd();
  });
</script>
