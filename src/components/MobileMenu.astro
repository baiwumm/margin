---
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconTag from "@/assets/icons/IconTag.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { SITE } from "@/config";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<div id="mobile-menu" class="mobile-menu sm:hidden" aria-hidden="true">
  <!-- Overlay/Backdrop -->
  <div class="mobile-menu-backdrop"></div>

  <!-- Floating Glass Panel -->
  <div class="app-layout">
    <div
      class="mobile-menu-panel relative mx-auto mt-2 w-full overflow-hidden rounded-2xl border border-white/10 shadow-2xl dark:border-white/5"
    >
      <div class="mobile-menu-inner">
        <nav class="mobile-nav-links">
          <a
            href="/posts"
            class:list={["mobile-nav-link", { active: isActive("/posts") }]}
            style="--i:0"
          >
            <span class="mobile-nav-indicator"></span>
            <span>Posts</span>
          </a>
          <a
            href="/about"
            class:list={["mobile-nav-link", { active: isActive("/about") }]}
            style="--i:1"
          >
            <span class="mobile-nav-indicator"></span>
            <span>About</span>
          </a>
        </nav>

        <div class="mobile-menu-divider"></div>

        <div class="mobile-menu-section">
          <span class="mobile-menu-section-label">Explore</span>
          <nav class="mobile-nav-links">
            <a
              href="/tags"
              class:list={["mobile-nav-link", { active: isActive("/tags") }]}
              style="--i:0"
            >
              <IconTag class="mobile-nav-link-icon" />
              <span>Tags</span>
            </a>
            {
              SITE.showArchives && (
                <a
                  href="/archives"
                  class:list={[
                    "mobile-nav-link",
                    { active: isActive("/archives") },
                  ]}
                  style="--i:1"
                >
                  <IconArchive class="mobile-nav-link-icon" />
                  <span>Archives</span>
                </a>
              )
            }
            {
              SITE.showGalleries && (
                <a
                  href="/galleries"
                  class:list={[
                    "mobile-nav-link",
                    { active: isActive("/galleries") },
                  ]}
                  style="--i:2"
                >
                  <IconGallery class="mobile-nav-link-icon" />
                  <span>Galleries</span>
                </a>
              )
            }
          </nav>
        </div>

        {
          SITE.lightAndDarkMode && (
            <div class="mobile-menu-section">
              <span class="mobile-menu-section-label">Preferences</span>
              <div class="mobile-pref-row" style="--i:3">
                <span>Theme</span>
                <div class="theme-segment" role="group" aria-label="Theme">
                  <button
                    type="button"
                    data-theme-option="light"
                    aria-pressed="false"
                    aria-label="Light mode"
                    title="Light"
                  >
                    <IconSunHigh class="size-4" />
                  </button>
                  <button
                    type="button"
                    data-theme-option="dark"
                    aria-pressed="false"
                    aria-label="Dark mode"
                    title="Dark"
                  >
                    <IconMoon class="size-4" />
                  </button>
                </div>
              </div>
              <div class="mobile-pref-row" style="--i:4">
                <span>Accent Color</span>
                <div class="accent-dots" role="group" aria-label="Accent color">
                  <button
                    type="button"
                    class="accent-dot"
                    data-accent-option="blue"
                    style="background: var(--accent-blue)"
                    aria-label="Blue"
                    aria-pressed="false"
                    title="Blue"
                  />
                  <button
                    type="button"
                    class="accent-dot"
                    data-accent-option="green"
                    style="background: var(--accent-green)"
                    aria-label="Green"
                    aria-pressed="false"
                    title="Green"
                  />
                  <button
                    type="button"
                    class="accent-dot"
                    data-accent-option="purple"
                    style="background: var(--accent-purple)"
                    aria-label="Purple"
                    aria-pressed="false"
                    title="Purple"
                  />
                  <button
                    type="button"
                    class="accent-dot"
                    data-accent-option="orange"
                    style="background: var(--accent-orange)"
                    aria-label="Orange"
                    aria-pressed="false"
                    title="Orange"
                  />
                  <button
                    type="button"
                    class="accent-dot"
                    data-accent-option="rose"
                    style="background: var(--accent-rose)"
                    aria-label="Rose"
                    aria-pressed="false"
                    title="Rose"
                  />
                </div>
              </div>
            </div>
          )
        }

        <div class="mobile-menu-divider"></div>

        <div class="mobile-menu-section">
          <span class="mobile-menu-section-label">Help</span>
          <button
            type="button"
            class="mobile-nav-link mobile-shortcuts-btn"
            data-shortcuts-trigger
            style="--i:5"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mobile-nav-link-icon"
              aria-hidden="true"
            >
              <rect x="2" y="6" width="20" height="12" rx="2"></rect>
              <path
                d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01M9 14h6"
              ></path>
            </svg>
            <span>Shortcuts</span>
          </button>
        </div>

        <div class="mobile-menu-divider"></div>

        <!-- Bottom action row -->
        <div class="mobile-menu-actions">
          <button
            data-search-trigger
            class="mobile-action-btn flex-1 justify-center"
            title="Search"
            aria-label="Open search"
          >
            <IconSearch class="size-4" />
            <span>Search</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ─── Mobile Menu Floating Sheet ─── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 30;
    pointer-events: none;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0);
    transition:
      background-color 0.4s ease,
      opacity 0.4s ease;
    opacity: 0;
    pointer-events: none;
  }

  .mobile-menu.is-open .mobile-menu-backdrop {
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel {
    background: color-mix(in srgb, var(--background) 80%, transparent);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.35s;
    visibility: hidden;
  }

  .mobile-menu.is-open .mobile-menu-panel {
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  /* ─── Mobile Menu Inner ─── */
  .mobile-menu-inner {
    position: relative;
    padding: 1rem;
  }

  /* ─── Mobile Nav Links ─── */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* ─── Mobile Menu Sections ─── */
  .mobile-menu-section {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .mobile-menu-section-label {
    padding: 0.25rem 1rem 0.125rem;
    font-family: var(--font-firacode), monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .mobile-nav-link-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .mobile-pref-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--foreground);
    opacity: 0;
    transform: translateY(8px);
  }

  .mobile-menu.is-open .mobile-pref-row {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    transition-delay: calc(0.08s * var(--i, 3) + 0.12s);
  }

  .mobile-nav-link.mobile-shortcuts-btn {
    width: 100%;
    border: none;
    background: transparent;
    font-family: inherit;
    text-align: start;
    cursor: pointer;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.75rem;
    transition:
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    opacity: 0;
    transform: translateY(8px);
  }

  .mobile-menu.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      color 0.1s ease-out,
      background-color 0.1s ease-out;
    transition-delay: calc(0.08s * var(--i, 0) + 0.12s);
  }

  :is(.mobile-nav-link, .mobile-action-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .mobile-action-btn:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .mobile-nav-link.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .mobile-nav-indicator {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--foreground) 20%, transparent);
    transition:
      background-color 0.1s ease-out,
      box-shadow 0.1s ease-out;
    flex-shrink: 0;
  }

  :is(.mobile-nav-link.active, .mobile-nav-link:hover) .mobile-nav-indicator {
    background: var(--accent);
  }

  .mobile-nav-link.active .mobile-nav-indicator {
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  /* ─── Menu Divider ─── */
  .mobile-menu-divider {
    margin: 0.75rem 0.5rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--border) 40%, transparent),
      transparent
    );
  }

  /* ─── Mobile Action Buttons ─── */
  .mobile-menu-actions {
    display: flex;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .mobile-menu.is-open .mobile-menu-actions {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.35s;
  }

  .mobile-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.625rem;
    border: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
    background: color-mix(in srgb, var(--background) 50%, transparent);
    backdrop-filter: blur(8px);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
    cursor: pointer;
  }
</style>
