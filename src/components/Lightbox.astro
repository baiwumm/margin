---
/**
 * Lightbox — 图片查看器外壳（文章正文 / 瞬间 / 画廊详情 / 画廊内嵌四处共用）。
 *
 * 只负责 dialog 的结构与样式；开合、换图、键盘、滚动锁等仍由各调用方的脚本处理，
 * 因此元素 id 统一为 `<id>-{counter,img,stage,caption,zoom-in,zoom-out,reset,rotate,close,prev,next}`，
 * 调用方按自己的前缀取值即可。画廊内嵌另用 `data-lb-*` 属性在多实例之间区分。
 */
interface Props {
  /** dialog 与内部元素的 id 前缀，如 "post-lightbox" */
  id: string;
  /** dialog 的无障碍名称 */
  label?: string;
}

const { id, label = "图片查看器" } = Astro.props;
---

<dialog id={id} class="lightbox" aria-label={label} aria-modal="true">
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span id={`${id}-counter`} class="lightbox-counter font-firacode"></span>
      <div class="lightbox-controls" role="toolbar" aria-label="预览工具栏">
        <button
          class="lightbox-btn lightbox-ctrl"
          id={`${id}-zoom-out`}
          data-lb-zoom-out={id}
          aria-label="缩小"
          title="缩小（-）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"
            ></line></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id={`${id}-zoom-in`}
          data-lb-zoom-in={id}
          aria-label="放大"
          title="放大（+）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"
            ></line><line x1="8" y1="11" x2="14" y2="11"></line></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id={`${id}-reset`}
          data-lb-reset={id}
          aria-label="重置缩放"
          title="重置（0）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="9"></circle><circle
              cx="12"
              cy="12"
              r="4"></circle><circle cx="12" cy="12" r="0.5"></circle></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id={`${id}-rotate`}
          data-lb-rotate={id}
          aria-label="旋转 90 度"
          title="旋转（r）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path><polyline
              points="21 3 21 8 16 8"></polyline></svg
          >
        </button>
      </div>
      <button
        class="lightbox-btn"
        id={`${id}-close`}
        data-lb-close={id}
        aria-label="关闭"
        title="关闭（Esc）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>
    </div>

    <div class="lightbox-main">
      <button
        class="lightbox-btn lightbox-nav lightbox-prev"
        id={`${id}-prev`}
        data-lb-prev={id}
        aria-label="上一张"
        title="上一张（←）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
      </button>

      <div class="lightbox-figure">
        <div class="lightbox-stage" id={`${id}-stage`}>
          <img
            id={`${id}-img`}
            src=""
            alt=""
            class="lightbox-image"
            decoding="async"
          />
        </div>
        <p id={`${id}-caption`} class="lightbox-caption text-foreground/80"></p>
      </div>

      <button
        class="lightbox-btn lightbox-nav lightbox-next"
        id={`${id}-next`}
        data-lb-next={id}
        aria-label="下一张"
        title="下一张（→）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
    </div>
  </div>
</dialog>

<style>
  /* 正文图片可点击预览 */
  :global(.app-prose img) {
    cursor: zoom-in;
  }

  /* ── Lightbox（与画廊灯箱同款交互与视觉） ── */
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: var(--background);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    flex-shrink: 0;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 1.5rem;
    min-height: 0;
    gap: 1.5rem;
  }

  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.25rem;
    overflow: hidden;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .lightbox-stage.slide-in-left {
    animation: lb-slide-left 0.45s ease-out;
  }

  .lightbox-stage.slide-in-right {
    animation: lb-slide-right 0.45s ease-out;
  }

  @keyframes lb-slide-left {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes lb-slide-right {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 10rem);
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    will-change: transform;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
    cursor: grab;
  }

  .lightbox-image.is-panning {
    cursor: grabbing;
  }

  .lightbox-caption {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    text-align: center;
    max-width: 50ch;
    line-height: 1.5;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 15%, transparent);
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px
      color-mix(in srgb, var(--background) 50%, transparent);
  }

  .lightbox-btn:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px -4px
      color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .lightbox-nav {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-image {
      transition: none !important;
    }
    .lightbox-stage.slide-in-left,
    .lightbox-stage.slide-in-right {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .lightbox-main {
      padding: 0 3.25rem 1rem;
      gap: 0;
      position: relative;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
    }
    .lightbox-nav:hover {
      transform: translateY(-50%) scale(1.1);
    }
    .lightbox-prev {
      left: 0.5rem;
    }
    .lightbox-next {
      right: 0.5rem;
    }
    .lightbox-image {
      max-height: calc(100vh - 8rem);
      max-height: calc(100dvh - 8rem);
    }
  }
</style>
