---
/**
 * ProjectCard — 开源项目卡片（Projects 页面使用）。
 *
 * 视觉沿用现有 `Card` 的设计语言：card-glow 鼠标辉光、rounded-2xl、
 * 玻璃拟态半透明背景、hover 上升 + accent 边框辉光。
 * 有 `repoUrl` 时标题左侧显示 GitHub 图标，点击标题跳转仓库；
 * 有 `npmUrl` 时标题旁追加 npm 图标链接；
 * 有 `homepageUrl` 时卡片底部显示「在线体验」胶囊按钮。
 */
import { LANGUAGE_COLORS, type Project } from "@/data/projects";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconNpm from "@/assets/icons/IconNpm.svg";

type Props = Project;

const {
  name,
  description,
  repoUrl,
  npmUrl,
  homepageUrl,
  language,
  stars,
  forks,
  tags,
  featured = false,
} = Astro.props as Props;

// Astro props 不做运行时校验，查不到颜色时由模板回退到 accent
const languageColor = language ? LANGUAGE_COLORS[language] : undefined;
---

<li
  class:list={[
    "card-glow group/card relative my-3 rounded-2xl",
    "border backdrop-blur-sm",
    "transition-[border-color,background-color,box-shadow,transform] duration-300 ease-out motion-reduce:transform-none motion-reduce:transition-none",
    "focus-within:-translate-y-0.5 hover:-translate-y-0.5",
    "focus-within:shadow-lg hover:shadow-lg",

    featured
      ? [
          "border-featured/30 bg-featured/5",
          "focus-within:border-featured/50 focus-within:bg-featured/10 hover:border-featured/50 hover:bg-featured/10",
          "focus-within:shadow-featured/10 hover:shadow-featured/10",
          "featured-glow",
        ]
      : [
          "border-border/25 bg-muted/10",
          "focus-within:border-accent/40 focus-within:bg-accent/5 hover:border-accent/40 hover:bg-accent/5",
          "focus-within:shadow-accent/10 hover:shadow-accent/10",
        ],
  ]}
>
  <!-- Cursor-following glow -->
  <div
    class="card-glow-effect pointer-events-none absolute inset-0 z-0 rounded-2xl opacity-0 transition-opacity duration-300 group-focus-within/card:opacity-100 group-hover/card:opacity-100 motion-reduce:transition-none"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-5 flex h-full flex-col p-4 sm:p-5">
    <!-- Meta row: language + stars/forks + featured badge -->
    <div class="pointer-events-none flex items-center gap-2">
      {
        language && (
          <span
            class="flex items-center gap-1.5 font-firacode text-xs text-foreground/70"
            title={language}
          >
            <span
              class="size-2.5 rounded-full"
              style={{
                backgroundColor: languageColor ?? "var(--color-accent)",
              }}
              aria-hidden="true"
            />
            {language}
          </span>
        )
      }

      <span class="flex-1"></span>

      {
        featured && (
          <span class="rounded-full border border-featured/30 bg-featured/10 px-2 py-0.5 text-xs font-medium text-featured">
            置顶
          </span>
        )
      }

      {
        typeof stars === "number" && (
          <span
            class="flex items-center gap-1 text-xs text-foreground/60"
            title={`${stars} Stars`}
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
            {stars}
          </span>
        )
      }

      {
        typeof forks === "number" && (
          <span
            class="flex items-center gap-1 text-xs text-foreground/60"
            title={`${forks} Forks`}
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="6" cy="5" r="3" />
              <circle cx="6" cy="19" r="3" />
              <circle cx="18" cy="5" r="3" />
              <path d="M6 8v8" />
              <path d="M18 8a6 6 0 0 1-6 6h-6" />
            </svg>
            {forks}
          </span>
        )
      }
    </div>

    <!-- Project name / repo link -->
    <h3
      class="mt-3 flex items-center gap-2 text-base font-semibold text-foreground"
    >
      {
        repoUrl ? (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group/name relative flex min-w-0 items-center gap-2 rounded-sm text-foreground transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none",
              featured
                ? "group-hover/card:text-featured focus-visible:ring-featured"
                : "group-hover/card:text-accent focus-visible:ring-accent",
            ]}
            aria-label={`${name}（GitHub 仓库）`}
            title="GitHub 仓库"
          >
            <IconGitHub class="size-4.5 shrink-0 text-foreground/55" />
            <span class="min-w-0 truncate font-firacode">{name}</span>
          </a>
        ) : (
          <span class="min-w-0 truncate font-firacode">{name}</span>
        )
      }

      {
        npmUrl && (
          <a
            href={npmUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 rounded-sm text-foreground/55 transition-colors duration-200 hover:text-accent focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:ring-accent focus-visible:outline-none"
            aria-label={`${name}（npm 包）`}
            title="npm 包"
          >
            <IconNpm class="size-4" />
          </a>
        )
      }
    </h3>

    <!-- Description -->
    <p
      class="pointer-events-auto relative z-20 mt-2 line-clamp-2 text-sm leading-relaxed text-foreground/75 select-text"
    >
      {description}
    </p>

    <!-- Footer: tech tags + demo button -->
    <div class="relative z-20 mt-auto flex flex-col items-end gap-3 pt-4">
      {
        tags.length > 0 && (
          <ul class="pointer-events-auto flex w-full flex-wrap gap-1.5">
            {tags.map(tag => (
              <li class="inline-flex items-center rounded-full border border-border/30 bg-background/40 px-2.5 py-0.5 text-xs font-medium text-foreground/70">
                {tag}
              </li>
            ))}
          </ul>
        )
      }

      {
        homepageUrl && (
          <a
            href={homepageUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-accent/30 bg-accent/10 px-3 py-1.5 text-xs font-medium text-accent backdrop-blur-sm transition-[border-color,background-color,box-shadow,transform] duration-300 hover:-translate-y-px hover:border-accent/50 hover:bg-accent/20 hover:shadow-accent/15 focus-visible:ring-2 focus-visible:ring-accent/45 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
          >
            <svg
              class="size-3.5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
            在线体验
          </a>
        )
      }
    </div>
  </div>
</li>
