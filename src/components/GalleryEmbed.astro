---
/**
 * GalleryEmbed — renders an inline grid of a gallery inside an MDX post.
 *
 * Usage in an .mdx file:
 *   <GalleryEmbed slug="gallery-folder-name" />
 *
 * Props:
 *   slug      — name of the folder in src/data/galleries/ (required)
 *   limit     — maximum number of images to show (default: 6; 0 = all)
 *   showLink  — show "View full gallery" link (default: true)
 *   cols      — grid columns: 2 | 3 | 4 (default: 3)
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

type Props = {
  slug: string;
  limit?: number;
  showLink?: boolean;
  cols?: 2 | 3 | 4;
};

const { slug, limit = 6, showLink = true, cols = 3 } = Astro.props;

// ── 1. Find the collection entry by slug ────────────────────────────
// Find ALL entries (including drafts) so the embed works in preview;
// the draft filter is applied by the author choosing not to publish the post.
const allGalleries = await getCollection("galleries");
const entry = allGalleries.find(g => {
  // Normalize separators and strip extension to match purely the slug
  const normalized = g.id
    .replace(/\\/g, "/")
    .replace(/\/index\.(md|mdx)$/, "")
    .replace(/\.(md|mdx)$/, "");
  return normalized === slug;
});

// ── 2. Load images from folder with a static glob ────────────────────
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

type GalleryImage = { src: ImageMetadata; alt: string };

function filenameToAlt(filename: string, fallback: string): string {
  return (
    filename
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]?/, "")
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, c => c.toUpperCase())
      .trim() || fallback
  );
}

const folderImages: GalleryImage[] = Object.entries(allImages)
  .filter(
    ([path]) =>
      path.startsWith(`/src/data/galleries/${slug}/`) && !path.includes("index")
  )
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split("/").pop() ?? "";
    return {
      src: mod.default,
      alt: filenameToAlt(filename, entry?.data.title ?? slug),
    };
  });

const visibleImages = limit > 0 ? folderImages.slice(0, limit) : folderImages;
const remaining = folderImages.length - visibleImages.length;

// Unique ID for the lightbox (allows multiple embeds on the same page)
const lbId = `ge-lb-${slug}`;

// CSS grid class according to requested columns
const gridClass = {
  2: "ge-grid-2",
  3: "ge-grid-3",
  4: "ge-grid-4",
}[cols];
---

{
  !entry ? (
    <div class="ge-error">
      ⚠️ Gallery <code>{slug}</code> not found. Verify that{" "}
      <code>src/data/galleries/{slug}/index.md</code> exists.
    </div>
  ) : (
    <figure class="gallery-embed not-prose" data-gallery-embed={slug}>
      {/* Embedded gallery header */}
      <div class="ge-header">
        <svg
          class="ge-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
        </svg>
        <span class="ge-title">{entry.data.title}</span>
        {remaining > 0 && <span class="ge-count">+{remaining} more</span>}
      </div>

      {/* Image grid */}
      {visibleImages.length > 0 ? (
        <ul
          class:list={["ge-grid", gridClass]}
          role="list"
          aria-label={`Gallery: ${entry.data.title}`}
        >
          {visibleImages.map((img, idx) => (
            <li>
              <button
                class="ge-item group"
                data-lb={lbId}
                data-index={idx}
                aria-label={`View image: ${img.alt}`}
                type="button"
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  class="ge-img"
                  loading={idx < 4 ? "eager" : "lazy"}
                  widths={[300, 600, 1200]}
                  sizes={`(max-width: 640px) ${cols === 2 ? "50vw" : "33vw"}, ${cols === 4 ? "25vw" : cols === 2 ? "40vw" : "30vw"}`}
                />
                <div class="ge-overlay">
                  <span class="ge-alt">{img.alt}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="ge-empty">This gallery doesn't have any images yet.</p>
      )}

      {/* Footer: description + link to full gallery */}
      <figcaption class="ge-footer">
        {entry.data.description && (
          <span class="ge-desc">{entry.data.description}</span>
        )}
        {showLink && (
          <a href={`/galleries/${slug}`} class="ge-link">
            View full gallery
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        )}
      </figcaption>
    </figure>
  )
}

<!-- Lightbox specific to this embed -->
<dialog
  id={lbId}
  class="lightbox"
  aria-label={`Viewer: ${entry?.data.title ?? slug}`}
  aria-modal="true"
>
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span id={`${lbId}-counter`} class="lightbox-counter font-firacode"></span>
      <div class="lightbox-controls" role="toolbar" aria-label="预览工具栏">
        <button class="lightbox-btn lightbox-ctrl" data-lb-zoom-out={lbId} aria-label="缩小" title="缩小（-）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
        </button>
        <button class="lightbox-btn lightbox-ctrl" data-lb-zoom-in={lbId} aria-label="放大" title="放大（+）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
        </button>
        <button class="lightbox-btn lightbox-ctrl" data-lb-reset={lbId} aria-label="重置缩放" title="重置（0）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="0.5"></circle></svg>
        </button>
        <button class="lightbox-btn lightbox-ctrl" data-lb-rotate={lbId} aria-label="旋转 90 度" title="旋转（r）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path><polyline points="21 3 21 8 16 8"></polyline></svg>
        </button>
      </div>
      <button class="lightbox-btn" data-lb-close={lbId} aria-label="关闭" title="关闭（Esc）" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="lightbox-main">
      <button class="lightbox-btn lightbox-nav ge-lb-prev" data-lb-prev={lbId} aria-label="上一张" title="上一张（←）" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      
      <div class="lightbox-figure">
        <div class="lightbox-stage">
          <img id={`${lbId}-img`} src="" alt="" class="lightbox-image" decoding="async" />
        </div>
        <p id={`${lbId}-caption`} class="lightbox-caption text-foreground/80"></p>
      </div>

      <button class="lightbox-btn lightbox-nav ge-lb-next" data-lb-next={lbId} aria-label="下一张" title="下一张（→）" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  let galleryCleanup: AbortController | null = null;

  function initEmbeds() {
    // 清理上一次初始化绑定的事件，避免 View Transitions 下监听器累积
    if (galleryCleanup) galleryCleanup.abort();
    galleryCleanup = new AbortController();
    const { signal } = galleryCleanup;

        // Initialize all gallery-embeds present on the page
        const preloadCache = new Set<string>();

        // 从 srcset 中取最大尺寸的版本，保证灯箱放大后清晰
        function pickLargestSrc(el: HTMLImageElement): string {
          const srcset = el.srcset;
          if (!srcset) return el.src;
          let best = "";
          let bestW = 0;
          for (const part of srcset.split(",")) {
            const pieces = part.trim().split(/\s+/);
            const w = pieces[1]?.endsWith("w") ? parseInt(pieces[1], 10) : 0;
            if (w > bestW) {
              bestW = w;
              best = pieces[0];
            }
          }
          return best || el.src;
        }

        // 预加载相邻图片，切换时无需等待网络
        function preloadImage(url: string) {
          if (!url || preloadCache.has(url)) return;
          preloadCache.add(url);
          const pre = new Image();
          pre.src = url;
        }

        document
          .querySelectorAll<HTMLElement>("[data-gallery-embed]")
      .forEach(embed => {
        const slug = embed.getAttribute("data-gallery-embed")!;
        const lbId = `ge-lb-${slug}`;
        const lb = document.getElementById(lbId) as HTMLDialogElement | null;
        if (!lb) return;
        const dialog = lb; // typed alias for closures

        const items = Array.from(
          embed.querySelectorAll<HTMLButtonElement>("[data-lb]")
        );
        if (items.length === 0) return;

        const lbImg = document.getElementById(
          `${lbId}-img`
        ) as HTMLImageElement | null;
        const lbCaption = document.getElementById(`${lbId}-caption`);
        const lbCounter = document.getElementById(`${lbId}-counter`);

        // ── 缩放 / 旋转 / 平移状态 ──
        let scale = 1;
        let rotation = 0;
        let tx = 0;
        let ty = 0;
        const pointers = new Map<number, { x: number; y: number }>();
        let pinchStartDistance = 0;
        let pinchStartScale = 1;
        let panStart: { x: number; y: number; tx: number; ty: number } | null =
          null;
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        function applyTransform(smooth = false) {
          if (!lbImg) return;
          lbImg.style.transition =
            smooth && !reduceMotion ? "transform 0.2s ease-out" : "none";
          lbImg.style.transform = `translate(${tx}px, ${ty}px) rotate(${rotation}deg) scale(${scale})`;
        }

        function resetTransform() {
          scale = 1;
          rotation = 0;
          tx = 0;
          ty = 0;
          lbImg?.classList.remove("is-panning");
          applyTransform(true);
        }

        function setScrollLock(locked: boolean) {
          const docEl = document.documentElement;
          const body = document.body;
          if (locked) {
            docEl.style.overflow = "hidden";
            body.style.overflow = "hidden";
            body.style.overscrollBehavior = "none";
          } else {
            docEl.style.overflow = "";
            body.style.overflow = "";
            body.style.overscrollBehavior = "";
          }
        }

        function panRange() {
          if (!lbImg) return { maxX: 0, maxY: 0 };
          const rect = lbImg.getBoundingClientRect();
          return {
            maxX: Math.max((rect.width - dialog.clientWidth) / 2, 0) + 40,
            maxY: Math.max((rect.height - dialog.clientHeight) / 2, 0) + 40,
          };
        }

        function zoomBy(factor: number) {
          const next = Math.min(4, Math.max(1, scale * factor));
          if (next === 1) {
            tx = 0;
            ty = 0;
          }
          scale = next;
          applyTransform(true);
        }

        let current = 0;
        let openSeq = 0;
        const stage = lb.querySelector(".lightbox-stage") as HTMLElement | null;

        stage?.addEventListener("animationend", () => {
          stage.classList.remove("slide-in-left", "slide-in-right");
        });

        async function open(idx: number) {
          const seq = ++openSeq;
          const direction = idx > current ? 1 : idx < current ? -1 : 0;
          current = Math.max(0, Math.min(idx, items.length - 1));
          const img = items[current].querySelector("img");
          if (!img || !lbImg) return;

          const largeSrc = pickLargestSrc(img);
          lbImg.src = largeSrc;
          lbImg.alt = img.alt;

          // 预加载相邻图片
          for (const neighbor of [current - 1, current + 1]) {
            const nb = items[neighbor]?.querySelector("img");
            if (nb) preloadImage(pickLargestSrc(nb));
          }

          // 等新图解码完成再一起更新文案并播放动画，避免“先显示 Alt”
          if (!reduceMotion && direction !== 0) {
            try {
              await lbImg.decode();
            } catch {
              // 解码失败时直接显示
            }
          }
          if (seq !== openSeq) return;

          if (lbCaption) lbCaption.textContent = img.alt;
          if (lbCounter)
            lbCounter.textContent = `${current + 1} / ${items.length}`;
          resetTransform();

          if (!reduceMotion && stage && direction !== 0) {
            stage.classList.remove("slide-in-left", "slide-in-right");
            void stage.offsetWidth; // 强制回流，保证动画可重复触发
            stage.classList.add(
              direction > 0 ? "slide-in-right" : "slide-in-left"
            );
          }

          dialog.showModal();
          setScrollLock(true);
        }

        function close() {
          dialog.close();
          setScrollLock(false);
        }

        // Image buttons
        items.forEach((btn, idx) => {
          btn.addEventListener("click", () => open(idx), { signal });
        });

        // Lightbox controls
        lb
          .querySelector("[data-lb-close]")
          ?.addEventListener("click", close, { signal });
        lb
          .querySelector("[data-lb-prev]")
          ?.addEventListener("click", () => open(current - 1), { signal });
        lb
          .querySelector("[data-lb-next]")
          ?.addEventListener("click", () => open(current + 1), { signal });
        lb
          .querySelector("[data-lb-zoom-in]")
          ?.addEventListener("click", () => zoomBy(1.5), { signal });
        lb
          .querySelector("[data-lb-zoom-out]")
          ?.addEventListener("click", () => zoomBy(1 / 1.5), { signal });
        lb
          .querySelector("[data-lb-reset]")
          ?.addEventListener("click", resetTransform, { signal });
        lb
          .querySelector("[data-lb-rotate]")
          ?.addEventListener(
            "click",
            () => {
              rotation = (rotation + 90) % 360;
              applyTransform(true);
            },
            { signal }
          );

        if (lbImg) {
          // 滚轮缩放
          lbImg.addEventListener(
            "wheel",
            e => {
              e.preventDefault();
              zoomBy(e.deltaY < 0 ? 1.15 : 1 / 1.15);
            },
            { passive: false, signal }
          );

          // 双指缩放 + 拖拽平移
          lbImg.addEventListener(
            "pointerdown",
            e => {
              lbImg.setPointerCapture(e.pointerId);
              pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
              lbImg.style.transition = "none";
              if (pointers.size === 2) {
                const [a, b] = [...pointers.values()];
                pinchStartDistance = Math.hypot(a.x - b.x, a.y - b.y);
                pinchStartScale = scale;
                panStart = null;
              } else if (pointers.size === 1 && scale > 1) {
                panStart = { x: e.clientX, y: e.clientY, tx, ty };
                lbImg.classList.add("is-panning");
              }
            },
            { signal }
          );
          lbImg.addEventListener(
            "pointermove",
            e => {
              const prev = pointers.get(e.pointerId);
              if (!prev) return;
              if (pointers.size === 2) {
                const other = [...pointers.entries()].find(
                  ([id]) => id !== e.pointerId
                );
                if (other && pinchStartDistance > 0) {
                  const [, a] = other;
                  const dist = Math.hypot(a.x - e.clientX, a.y - e.clientY);
                  const next = Math.min(
                    4,
                    Math.max(1, pinchStartScale * (dist / pinchStartDistance))
                  );
                  if (next === 1) {
                    tx = 0;
                    ty = 0;
                  }
                  scale = next;
                  applyTransform(false);
                }
                pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
              } else if (panStart) {
                const { maxX, maxY } = panRange();
                tx = Math.max(
                  -maxX,
                  Math.min(maxX, panStart.tx + (e.clientX - panStart.x))
                );
                ty = Math.max(
                  -maxY,
                  Math.min(maxY, panStart.ty + (e.clientY - panStart.y))
                );
                applyTransform(false);
              } else {
                pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
              }
            },
            { signal }
          );
          const endPointer = (e: PointerEvent) => {
            pointers.delete(e.pointerId);
            lbImg.classList.remove("is-panning");
            if (pointers.size < 2) pinchStartDistance = 0;
            if (pointers.size === 1) {
              const [, p] = [...pointers.entries()][0];
              panStart = scale > 1 ? { x: p.x, y: p.y, tx, ty } : null;
            } else if (pointers.size === 0) {
              panStart = null;
            }
          };
          lbImg.addEventListener("pointerup", endPointer, { signal });
          lbImg.addEventListener("pointercancel", endPointer, { signal });
          lbImg.addEventListener("lostpointercapture", endPointer, { signal });

          // 双击缩放 / 还原
          lbImg.addEventListener(
            "dblclick",
            () => {
              if (scale > 1) {
                resetTransform();
              } else {
                scale = 2;
                applyTransform(true);
              }
            },
            { signal }
          );
        }

        // Close when clicking the backdrop
        lb.addEventListener(
          "click",
          e => {
            if (e.target === dialog) close();
          },
          { signal }
        );

        // Keyboard — only if THIS lightbox is open
        document.addEventListener(
          "keydown",
          e => {
            if (!dialog.open) return;
            if (e.key === "Escape") close();
            if (e.key === "ArrowLeft") open(current - 1);
            if (e.key === "ArrowRight") open(current + 1);
            if (e.key === "+" || e.key === "=") zoomBy(1.25);
            if (e.key === "-" || e.key === "_") zoomBy(1 / 1.25);
            if (e.key === "0") resetTransform();
            if (e.key.toLowerCase() === "r") {
              rotation = (rotation + 90) % 360;
              applyTransform(true);
            }
          },
          { signal }
        );
      });
  }

  initEmbeds();
  document.addEventListener("astro:after-swap", initEmbeds);
</script>

<style>
  /* ── Container ── */
  .gallery-embed {
    margin-block: 2rem;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    border-radius: 1rem;
    overflow: hidden;
  }

  /* ── Header ── */
  .ge-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
  }
  .ge-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
  .ge-title {
    font-size: 0.875rem;
    font-weight: 600;
    flex: 1;
  }
  .ge-count {
    font-size: 0.75rem;
    color: var(--foreground);
    opacity: 0.5;
  }

  /* ── Grid ── */
  .ge-grid {
    display: grid;
    gap: 2px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ge-grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .ge-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .ge-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 480px) {
    .ge-grid-3,
    .ge-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Image item ── */
  .ge-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    padding: 0;
    border: none;
  }
  .ge-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    display: block;
  }
  .ge-item:hover .ge-img {
    transform: scale(1.06);
  }
  .ge-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.25s;
  }
  .ge-item:hover .ge-overlay,
  .ge-item:focus-visible .ge-overlay {
    opacity: 1;
  }
  .ge-alt {
    font-size: 0.7rem;
    color: white;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    line-height: 1.3;
  }

  /* ── Footer ── */
  .ge-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
    background: color-mix(in srgb, var(--foreground) 2%, transparent);
  }
