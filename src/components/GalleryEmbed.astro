---
/**
 * GalleryEmbed — renders an inline grid of a gallery inside an MDX post.
 *
 * Usage in an .mdx file:
 *   <GalleryEmbed slug="gallery-folder-name" />
 *
 * Props:
 *   slug      — name of the folder in src/data/galleries/ (required)
 *   limit     — maximum number of images to show (default: 6; 0 = all)
 *   showLink  — show "View full gallery" link (default: true)
 *   cols      — grid columns: 2 | 3 | 4 (default: 3)
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

type Props = {
  slug: string;
  limit?: number;
  showLink?: boolean;
  cols?: 2 | 3 | 4;
};

const { slug, limit = 6, showLink = true, cols = 3 } = Astro.props;

// ── 1. Find the collection entry by slug ────────────────────────────
// Find ALL entries (including drafts) so the embed works in preview;
// the draft filter is applied by the author choosing not to publish the post.
const allGalleries = await getCollection("galleries");
const entry = allGalleries.find(g => {
  // Normalize separators and strip extension to match purely the slug
  const normalized = g.id
    .replace(/\\/g, "/")
    .replace(/\/index\.(md|mdx)$/, "")
    .replace(/\.(md|mdx)$/, "");
  return normalized === slug;
});

// ── 2. Load images from folder with a static glob ────────────────────
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

type GalleryImage = { src: ImageMetadata; alt: string };

function filenameToAlt(filename: string, fallback: string): string {
  return (
    filename
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]?/, "")
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, c => c.toUpperCase())
      .trim() || fallback
  );
}

const folderImages: GalleryImage[] = Object.entries(allImages)
  .filter(
    ([path]) =>
      path.startsWith(`/src/data/galleries/${slug}/`) && !path.includes("index")
  )
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split("/").pop() ?? "";
    return {
      src: mod.default,
      alt: filenameToAlt(filename, entry?.data.title ?? slug),
    };
  });

const visibleImages = limit > 0 ? folderImages.slice(0, limit) : folderImages;
const remaining = folderImages.length - visibleImages.length;

// Unique ID for the lightbox (allows multiple embeds on the same page)
const lbId = `ge-lb-${slug}`;

// CSS grid class according to requested columns
const gridClass = {
  2: "ge-grid-2",
  3: "ge-grid-3",
  4: "ge-grid-4",
}[cols];
import Lightbox from "@/components/Lightbox.astro";
---

{
  !entry ? (
    <div class="ge-error">
      ⚠️ Gallery <code>{slug}</code> not found. Verify that{" "}
      <code>src/data/galleries/{slug}/index.md</code> exists.
    </div>
  ) : (
    <figure class="gallery-embed not-prose" data-gallery-embed={slug}>
      {/* Embedded gallery header */}
      <div class="ge-header">
        <svg
          class="ge-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
        </svg>
        <span class="ge-title">{entry.data.title}</span>
        {remaining > 0 && <span class="ge-count">+{remaining} more</span>}
      </div>

      {/* Image grid */}
      {visibleImages.length > 0 ? (
        <ul
          class:list={["ge-grid", gridClass]}
          role="list"
          aria-label={`Gallery: ${entry.data.title}`}
        >
          {visibleImages.map((img, idx) => (
            <li>
              <button
                class="ge-item group"
                data-lb={lbId}
                data-index={idx}
                aria-label={`View image: ${img.alt}`}
                type="button"
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  class="ge-img"
                  loading={idx < 4 ? "eager" : "lazy"}
                  widths={[300, 600, 1200]}
                  sizes={`(max-width: 640px) ${cols === 2 ? "50vw" : "33vw"}, ${cols === 4 ? "25vw" : cols === 2 ? "40vw" : "30vw"}`}
                />
                <div class="ge-overlay">
                  <span class="ge-alt">{img.alt}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="ge-empty">This gallery doesn't have any images yet.</p>
      )}

      {/* Footer: description + link to full gallery */}
      <figcaption class="ge-footer">
        {entry.data.description && (
          <span class="ge-desc">{entry.data.description}</span>
        )}
        {showLink && (
          <a href={`/galleries/${slug}`} class="ge-link">
            View full gallery
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        )}
      </figcaption>
    </figure>
  )
}

<!-- Lightbox specific to this embed -->
<Lightbox id={lbId} label={`查看图片：${entry?.data.title ?? slug}`} />

<script>
  import { attachLightboxGestures } from "@/utils/lightboxGestures";

  let galleryCleanup: AbortController | null = null;

  function initEmbeds() {
    // 清理上一次初始化绑定的事件，避免 View Transitions 下监听器累积
    if (galleryCleanup) galleryCleanup.abort();
    galleryCleanup = new AbortController();
    const { signal } = galleryCleanup;

    // Initialize all gallery-embeds present on the page
    const preloadCache = new Set<string>();

    // 从 srcset 中取最大尺寸的版本，保证灯箱放大后清晰
    function pickLargestSrc(el: HTMLImageElement): string {
      const srcset = el.srcset;
      if (!srcset) return el.src;
      let best = "";
      let bestW = 0;
      for (const part of srcset.split(",")) {
        const pieces = part.trim().split(/\s+/);
        const w = pieces[1]?.endsWith("w") ? parseInt(pieces[1], 10) : 0;
        if (w > bestW) {
          bestW = w;
          best = pieces[0];
        }
      }
      return best || el.src;
    }

    // 预加载相邻图片，切换时无需等待网络
    function preloadImage(url: string) {
      if (!url || preloadCache.has(url)) return;
      preloadCache.add(url);
      const pre = new Image();
      pre.src = url;
    }

    document
      .querySelectorAll<HTMLElement>("[data-gallery-embed]")
      .forEach(embed => {
        const slug = embed.getAttribute("data-gallery-embed")!;
        const lbId = `ge-lb-${slug}`;
        const lb = document.getElementById(lbId) as HTMLDialogElement | null;
        if (!lb) return;
        const dialog = lb; // typed alias for closures

        const items = Array.from(
          embed.querySelectorAll<HTMLButtonElement>("[data-lb]")
        );
        if (items.length === 0) return;

        const lbImg = document.getElementById(
          `${lbId}-img`
        ) as HTMLImageElement | null;
        const lbCaption = document.getElementById(`${lbId}-caption`);
        const lbCounter = document.getElementById(`${lbId}-counter`);

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        function setScrollLock(locked: boolean) {
          const docEl = document.documentElement;
          const body = document.body;
          if (locked) {
            docEl.style.overflow = "hidden";
            body.style.overflow = "hidden";
            body.style.overscrollBehavior = "none";
          } else {
            docEl.style.overflow = "";
            body.style.overflow = "";
            body.style.overscrollBehavior = "";
          }
        }

        // 手势引擎：滚轮/双指缩放、平移、双击、旋转、单指滑动切换（四处灯箱共用）；
        // lbImg 缺失时降级为 no-op，灯箱仅退化为无缩放/手势的查看器
        const lbGestures = lbImg
          ? attachLightboxGestures({
              img: lbImg,
              viewport: dialog,
              signal,
              onSwipe: direction => {
                const next = current + direction;
                if (next >= 0 && next < items.length) open(next);
              },
            })
          : null;

        let current = 0;
        let openSeq = 0;
        const stage = lb.querySelector(".lightbox-stage") as HTMLElement | null;

        stage?.addEventListener("animationend", () => {
          stage.classList.remove("slide-in-left", "slide-in-right");
        });

        async function open(idx: number) {
          const seq = ++openSeq;
          const direction = idx > current ? 1 : idx < current ? -1 : 0;
          current = Math.max(0, Math.min(idx, items.length - 1));
          const img = items[current].querySelector("img");
          if (!img || !lbImg) return;

          const largeSrc = pickLargestSrc(img);
          lbImg.src = largeSrc;
          lbImg.alt = img.alt;

          // 预加载相邻图片
          for (const neighbor of [current - 1, current + 1]) {
            const nb = items[neighbor]?.querySelector("img");
            if (nb) preloadImage(pickLargestSrc(nb));
          }

          // 等新图解码完成再一起更新文案并播放动画，避免“先显示 Alt”；
          // 带超时兜底（dialog 未打开时图片不可见，decode 可能迟迟不兑现），
          // 与 MomentLightbox 一致，不卡死交互
          if (!reduceMotion && direction !== 0) {
            try {
              await Promise.race([
                lbImg.decode(),
                new Promise(resolve => setTimeout(resolve, 600)),
              ]);
            } catch {
              // 解码失败时直接显示
            }
          }
          if (seq !== openSeq) return;

          if (lbCaption) lbCaption.textContent = img.alt;
          if (lbCounter)
            lbCounter.textContent = `${current + 1} / ${items.length}`;
          lbGestures?.resetTransform();

          if (!reduceMotion && stage && direction !== 0) {
            stage.classList.remove("slide-in-left", "slide-in-right");
            void stage.offsetWidth; // 强制回流，保证动画可重复触发
            stage.classList.add(
              direction > 0 ? "slide-in-right" : "slide-in-left"
            );
          }

          dialog.showModal();
          setScrollLock(true);
        }

        function close() {
          dialog.close();
          setScrollLock(false);
        }

        // Image buttons
        items.forEach((btn, idx) => {
          btn.addEventListener("click", () => open(idx), { signal });
        });

        // Lightbox controls
        lb.querySelector("[data-lb-close]")?.addEventListener("click", close, {
          signal,
        });
        lb.querySelector("[data-lb-prev]")?.addEventListener(
          "click",
          () => open(current - 1),
          { signal }
        );
        lb.querySelector("[data-lb-next]")?.addEventListener(
          "click",
          () => open(current + 1),
          { signal }
        );
        lb.querySelector("[data-lb-zoom-in]")?.addEventListener(
          "click",
          () => lbGestures?.zoomBy(1.5),
          { signal }
        );
        lb.querySelector("[data-lb-zoom-out]")?.addEventListener(
          "click",
          () => lbGestures?.zoomBy(1 / 1.5),
          { signal }
        );
        lb.querySelector("[data-lb-reset]")?.addEventListener(
          "click",
          () => lbGestures?.resetTransform(),
          { signal }
        );
        lb.querySelector("[data-lb-rotate]")?.addEventListener(
          "click",
          () => lbGestures?.rotate(),
          { signal }
        );

        // 手势（滚轮 / 双指 / 双击 / 滑动）由 attachLightboxGestures 统一绑定

        // Keyboard — only if THIS lightbox is open
        document.addEventListener(
          "keydown",
          e => {
            if (!dialog.open) return;
            if (e.key === "Escape") close();
            if (e.key === "ArrowLeft") open(current - 1);
            if (e.key === "ArrowRight") open(current + 1);
            if (e.key === "+" || e.key === "=") lbGestures?.zoomBy(1.25);
            if (e.key === "-" || e.key === "_") lbGestures?.zoomBy(1 / 1.25);
            if (e.key === "0") lbGestures?.resetTransform();
            if (e.key.toLowerCase() === "r") lbGestures?.rotate();
          },
          { signal }
        );
      });
  }

  initEmbeds();
  document.addEventListener("astro:after-swap", initEmbeds);
</script>

<style>
  /* ── Container ── */
  .gallery-embed {
    margin-block: 2rem;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    border-radius: 1rem;
    overflow: hidden;
  }

  /* ── Header ── */
  .ge-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
  }
  .ge-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
  .ge-title {
    font-size: 0.875rem;
    font-weight: 600;
    flex: 1;
  }
  .ge-count {
    font-size: 0.75rem;
    color: var(--foreground);
    opacity: 0.5;
  }

  /* ── Grid ── */
  .ge-grid {
    display: grid;
    gap: 6px;
    list-style: none;
    padding: 10px;
    margin: 0;
  }
  .ge-grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .ge-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .ge-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 480px) {
    .ge-grid-3,
    .ge-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Image item ── */
  .ge-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.75rem;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    padding: 0;
    border: none;
    z-index: 1;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .ge-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* 整个格子悬停时浮起放大：图片不再被 overflow 硬切，圆角 + 阴影跟随
     格子整体缩放，alt 遮罩同步放大，避免裁剪露边 */
  .ge-item:hover,
  .ge-item:focus-visible {
    z-index: 2;
    transform: scale(1.02);
    box-shadow: 0 12px 32px -12px
      color-mix(in srgb, var(--accent) 35%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .ge-item {
      transition: none;
    }
    .ge-item:hover,
    .ge-item:focus-visible {
      transform: none;
    }
  }
  .ge-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.25s;
  }
  .ge-item:hover .ge-overlay,
  .ge-item:focus-visible .ge-overlay {
    opacity: 1;
  }
  .ge-alt {
    font-size: 0.7rem;
    color: white;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    line-height: 1.3;
  }

  /* ── Footer ── */
  .ge-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
    background: color-mix(in srgb, var(--foreground) 2%, transparent);
  }
  .ge-desc {
    font-size: 0.8rem;
    opacity: 0.6;
    line-height: 1.4;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
    text-decoration: none;
    /* 覆盖 .app-prose a 的渐变下划线，避免悬停时与 text-decoration 叠加成双横线 */
    background-image: none;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }
  .ge-link:hover {
    opacity: 0.75;
    text-decoration: underline;
  }

  /* ── Error ── */
  .ge-error {
    margin-block: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent-rose) 40%, transparent);
    background: color-mix(in srgb, var(--accent-rose) 8%, transparent);
    font-size: 0.875rem;
  }
  .ge-empty {
    padding: 2rem;
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.5;
  }
</style>
