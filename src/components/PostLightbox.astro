---
/**
 * PostLightbox — 文章正文图片点击预览（画廊同款灯箱交互）。
 *
 * 自动收集 `.app-prose` 内的所有正文图片（排除画廊内嵌与灯箱自身），
 * 支持点击放大、上一张/下一张、缩放、旋转、平移、键盘与双指手势。
 */
---

<dialog
  id="post-lightbox"
  class="lightbox"
  aria-label="图片查看器"
  aria-modal="true"
>
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span id="post-lightbox-counter" class="lightbox-counter font-firacode"
      ></span>
      <div class="lightbox-controls" role="toolbar" aria-label="预览工具栏">
        <button
          class="lightbox-btn lightbox-ctrl"
          id="post-lightbox-zoom-out"
          aria-label="缩小"
          title="缩小（-）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"
            ></line></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id="post-lightbox-zoom-in"
          aria-label="放大"
          title="放大（+）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="7"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"
            ></line><line x1="8" y1="11" x2="14" y2="11"></line></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id="post-lightbox-reset"
          aria-label="重置缩放"
          title="重置（0）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="9"></circle><circle
              cx="12"
              cy="12"
              r="4"></circle><circle cx="12" cy="12" r="0.5"></circle></svg
          >
        </button>
        <button
          class="lightbox-btn lightbox-ctrl"
          id="post-lightbox-rotate"
          aria-label="旋转 90 度"
          title="旋转（r）"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path><polyline
              points="21 3 21 8 16 8"></polyline></svg
          >
        </button>
      </div>
      <button
        class="lightbox-btn"
        id="post-lightbox-close"
        aria-label="关闭"
        title="关闭（Esc）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>
    </div>

    <div class="lightbox-main">
      <button
        class="lightbox-btn lightbox-nav"
        id="post-lightbox-prev"
        aria-label="上一张"
        title="上一张（←）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
      </button>

      <div class="lightbox-figure">
        <div class="lightbox-stage" id="post-lightbox-stage">
          <img
            id="post-lightbox-img"
            src=""
            alt=""
            class="lightbox-image"
            decoding="async"
          />
        </div>
        <p
          id="post-lightbox-caption"
          class="lightbox-caption text-foreground/80"
        >
        </p>
      </div>

      <button
        class="lightbox-btn lightbox-nav"
        id="post-lightbox-next"
        aria-label="下一张"
        title="下一张（→）"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
    </div>
  </div>
</dialog>

<script>
  import { attachLightboxGestures } from "@/utils/lightboxGestures";

  let postLightboxCleanup: AbortController | null = null;

  function initPostLightbox() {
    // 清理上一次初始化绑定的事件，避免 View Transitions 下监听器累积
    if (postLightboxCleanup) postLightboxCleanup.abort();
    postLightboxCleanup = new AbortController();
    const { signal } = postLightboxCleanup;

    const dialog = document.getElementById(
      "post-lightbox"
    ) as HTMLDialogElement | null;
    if (!dialog) return;
    // From here TypeScript does not carry narrowing to closures; use the local variable
    const lb = dialog;

    // 收集正文图片（排除画廊内嵌与灯箱自身，避免事件冲突）
    const items = Array.from(
      document.querySelectorAll<HTMLImageElement>(".app-prose img")
    ).filter(
      img => !img.closest("[data-gallery-embed]") && !img.closest(".lightbox")
    );

    const lbImg = document.getElementById(
      "post-lightbox-img"
    ) as HTMLImageElement;
    const lbCaption = document.getElementById("post-lightbox-caption");
    const lbCounter = document.getElementById("post-lightbox-counter");
    const prevBtn = document.getElementById("post-lightbox-prev");
    const nextBtn = document.getElementById("post-lightbox-next");
    if (items.length === 0) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    function setScrollLock(locked: boolean) {
      const docEl = document.documentElement;
      const body = document.body;
      if (locked) {
        docEl.style.overflow = "hidden";
        body.style.overflow = "hidden";
        body.style.overscrollBehavior = "none";
      } else {
        docEl.style.overflow = "";
        body.style.overflow = "";
        body.style.overscrollBehavior = "";
      }
    }

    let current = 0;
    let openSeq = 0;
    const stage = document.getElementById(
      "post-lightbox-stage"
    ) as HTMLElement | null;
    const preloadCache = new Set<string>();

    stage?.addEventListener("animationend", () => {
      stage.classList.remove("slide-in-left", "slide-in-right");
    });

    // 从 srcset 中取最大尺寸的版本，保证灯箱放大后清晰
    function pickLargestSrc(el: HTMLImageElement): string {
      const srcset = el.srcset;
      if (!srcset) return el.src;
      let best = "";
      let bestW = 0;
      for (const part of srcset.split(",")) {
        const pieces = part.trim().split(/\s+/);
        const w = pieces[1]?.endsWith("w") ? parseInt(pieces[1], 10) : 0;
        if (w > bestW) {
          bestW = w;
          best = pieces[0];
        }
      }
      return best || el.src;
    }

    // 预加载相邻图片，切换时无需等待网络
    function preloadImage(url: string) {
      if (!url || preloadCache.has(url)) return;
      preloadCache.add(url);
      const pre = new Image();
      pre.src = url;
    }

    // 手势引擎：滚轮/双指缩放、平移、双击、旋转、单指滑动切换（四处灯箱共用）
    const { zoomBy, resetTransform, rotate } = attachLightboxGestures({
      img: lbImg,
      viewport: lb,
      signal,
      onSwipe: direction => {
        const next = current + direction;
        if (next >= 0 && next < items.length) open(next);
      },
    });

    async function open(idx: number) {
      const seq = ++openSeq;
      const direction = idx > current ? 1 : idx < current ? -1 : 0;
      current = Math.max(0, Math.min(idx, items.length - 1));
      const img = items[current];
      if (!img) return;

      const largeSrc = pickLargestSrc(img);
      lbImg.src = largeSrc;
      lbImg.alt = img.alt;

      // 预加载相邻图片
      for (const neighbor of [current - 1, current + 1]) {
        const nb = items[neighbor];
        if (nb) preloadImage(pickLargestSrc(nb));
      }

      // 等新图解码完成再一起更新文案并播放动画，避免“先显示 Alt”；
      // 带超时兜底（dialog 未打开时图片不可见，decode 可能迟迟不兑现），
      // 与 MomentLightbox 一致，不卡死交互
      if (!reduceMotion && direction !== 0) {
        try {
          await Promise.race([
            lbImg.decode(),
            new Promise(resolve => setTimeout(resolve, 600)),
          ]);
        } catch {
          // 解码失败时直接显示
        }
      }
      if (seq !== openSeq) return;

      if (lbCaption) lbCaption.textContent = img.alt;
      if (lbCounter) lbCounter.textContent = `${current + 1} / ${items.length}`;
      resetTransform();

      if (!reduceMotion && stage && direction !== 0) {
        stage.classList.remove("slide-in-left", "slide-in-right");
        void stage.offsetWidth; // 强制回流，保证动画可重复触发
        stage.classList.add(direction > 0 ? "slide-in-right" : "slide-in-left");
      }

      // 首图隐藏“上一张”，尾图隐藏“下一张”（与画廊灯箱一致）
      if (prevBtn)
        prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
      if (nextBtn)
        nextBtn.style.visibility =
          current === items.length - 1 ? "hidden" : "visible";

      lb.showModal();
      setScrollLock(true);
    }

    function close() {
      lb.close();
      setScrollLock(false);
    }

    // 正文图片点击打开灯箱；图片位于链接内（如链接卡片缩略图）时
    // 阻止默认跳转，仅放大预览
    items.forEach((img, idx) => {
      img.addEventListener(
        "click",
        e => {
          if (img.closest("a")) e.preventDefault();
          open(idx);
        },
        { signal }
      );
    });

    // 灯箱控制按钮
    document
      .getElementById("post-lightbox-close")
      ?.addEventListener("click", close, { signal });
    document
      .getElementById("post-lightbox-prev")
      ?.addEventListener("click", () => open(current - 1), { signal });
    document
      .getElementById("post-lightbox-next")
      ?.addEventListener("click", () => open(current + 1), { signal });
    document
      .getElementById("post-lightbox-zoom-in")
      ?.addEventListener("click", () => zoomBy(1.5), { signal });
    document
      .getElementById("post-lightbox-zoom-out")
      ?.addEventListener("click", () => zoomBy(1 / 1.5), { signal });
    document
      .getElementById("post-lightbox-reset")
      ?.addEventListener("click", resetTransform, { signal });
    document
      .getElementById("post-lightbox-rotate")
      ?.addEventListener("click", rotate, { signal });

    // 手势（滚轮 / 双指 / 双击 / 滑动）由 attachLightboxGestures 统一绑定

    // 点击背景关闭
    lb.addEventListener(
      "click",
      e => {
        if (e.target === lb) close();
      },
      { signal }
    );

    // 键盘控制——仅在灯箱打开时生效
    document.addEventListener(
      "keydown",
      e => {
        if (!lb.open) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") open(current - 1);
        if (e.key === "ArrowRight") open(current + 1);
        if (e.key === "+" || e.key === "=") zoomBy(1.25);
        if (e.key === "-" || e.key === "_") zoomBy(1 / 1.25);
        if (e.key === "0") resetTransform();
        if (e.key.toLowerCase() === "r") rotate();
      },
      { signal }
    );
  }

  initPostLightbox();
  document.addEventListener("astro:after-swap", initPostLightbox);
</script>

<style>
  /* 正文图片可点击预览 */
  :global(.app-prose img) {
    cursor: zoom-in;
  }

  /* ── Lightbox（与画廊灯箱同款交互与视觉） ── */
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: var(--background);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    flex-shrink: 0;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 1.5rem;
    min-height: 0;
    gap: 1.5rem;
  }

  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.25rem;
    overflow: hidden;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .lightbox-stage.slide-in-left {
    animation: lb-slide-left 0.45s ease-out;
  }

  .lightbox-stage.slide-in-right {
    animation: lb-slide-right 0.45s ease-out;
  }

  @keyframes lb-slide-left {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes lb-slide-right {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 10rem);
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    will-change: transform;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
    cursor: grab;
  }

  .lightbox-image.is-panning {
    cursor: grabbing;
  }

  .lightbox-caption {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    text-align: center;
    max-width: 50ch;
    line-height: 1.5;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 15%, transparent);
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px
      color-mix(in srgb, var(--background) 50%, transparent);
  }

  .lightbox-btn:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px -4px
      color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .lightbox-nav {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-image {
      transition: none !important;
    }
    .lightbox-stage.slide-in-left,
    .lightbox-stage.slide-in-right {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .lightbox-main {
      padding: 0 3.25rem 1rem;
      gap: 0;
      position: relative;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
    }
    .lightbox-nav:hover {
      transform: translateY(-50%) scale(1.1);
    }
    #post-lightbox-prev {
      left: 0.5rem;
    }
    #post-lightbox-next {
      right: 0.5rem;
    }
    .lightbox-image {
      max-height: calc(100vh - 8rem);
      max-height: calc(100dvh - 8rem);
    }
  }
</style>
