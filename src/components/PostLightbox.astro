---
/**
 * PostLightbox — 文章正文图片点击预览（画廊同款灯箱交互）。
 *
 * 自动收集 `.app-prose` 内的所有正文图片（排除画廊内嵌与灯箱自身），
 * 支持点击放大、上一张/下一张、缩放、旋转、平移、键盘与双指手势。
 */
---

<dialog id="post-lightbox" class="lightbox" aria-label="图片查看器" aria-modal="true">
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span id="post-lightbox-counter" class="lightbox-counter font-firacode"></span>
      <div class="lightbox-controls" role="toolbar" aria-label="预览工具栏">
        <button class="lightbox-btn lightbox-ctrl" id="post-lightbox-zoom-out" aria-label="缩小" title="缩小（-）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
        </button>
        <button class="lightbox-btn lightbox-ctrl" id="post-lightbox-zoom-in" aria-label="放大" title="放大（+）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
        </button>
        <button class="lightbox-btn lightbox-ctrl" id="post-lightbox-reset" aria-label="重置缩放" title="重置（0）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="0.5"></circle></svg>
        </button>
        <button class="lightbox-btn lightbox-ctrl" id="post-lightbox-rotate" aria-label="旋转 90 度" title="旋转（r）" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path><polyline points="21 3 21 8 16 8"></polyline></svg>
        </button>
      </div>
      <button class="lightbox-btn" id="post-lightbox-close" aria-label="关闭" title="关闭（Esc）" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="lightbox-main">
      <button class="lightbox-btn lightbox-nav" id="post-lightbox-prev" aria-label="上一张" title="上一张（←）" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="lightbox-figure">
        <div class="lightbox-stage" id="post-lightbox-stage">
          <img id="post-lightbox-img" src="" alt="" class="lightbox-image" decoding="async" />
        </div>
        <p id="post-lightbox-caption" class="lightbox-caption text-foreground/80"></p>
      </div>

      <button class="lightbox-btn lightbox-nav" id="post-lightbox-next" aria-label="下一张" title="下一张（→）" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  let postLightboxCleanup: AbortController | null = null;

  function initPostLightbox() {
    // 清理上一次初始化绑定的事件，避免 View Transitions 下监听器累积
    if (postLightboxCleanup) postLightboxCleanup.abort();
    postLightboxCleanup = new AbortController();
    const { signal } = postLightboxCleanup;

    const dialog = document.getElementById(
      "post-lightbox"
    ) as HTMLDialogElement | null;
    if (!dialog) return;
    // From here TypeScript does not carry narrowing to closures; use the local variable
    const lb = dialog;

    // 收集正文图片（排除画廊内嵌与灯箱自身，避免事件冲突）
    const items = Array.from(
      document.querySelectorAll<HTMLImageElement>(".app-prose img")
    ).filter(
      img =>
        !img.closest("[data-gallery-embed]") && !img.closest(".lightbox")
    );

    const lbImg = document.getElementById(
      "post-lightbox-img"
    ) as HTMLImageElement;
    const lbCaption = document.getElementById("post-lightbox-caption");
    const lbCounter = document.getElementById("post-lightbox-counter");
    const prevBtn = document.getElementById("post-lightbox-prev");
    const nextBtn = document.getElementById("post-lightbox-next");
    if (items.length === 0) return;

    // ── 缩放 / 旋转 / 平移状态 ──
    let scale = 1;
    let rotation = 0;
    let tx = 0;
    let ty = 0;
    const pointers = new Map<number, { x: number; y: number }>();
    let pinchStartDistance = 0;
    let pinchStartScale = 1;
    let panStart: { x: number; y: number; tx: number; ty: number } | null =
      null;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    function applyTransform(smooth = false) {
      lbImg.style.transition =
        smooth && !reduceMotion ? "transform 0.2s ease-out" : "none";
      lbImg.style.transform = `translate(${tx}px, ${ty}px) rotate(${rotation}deg) scale(${scale})`;
    }

    function resetTransform() {
      scale = 1;
      rotation = 0;
      tx = 0;
      ty = 0;
      lbImg.classList.remove("is-panning");
      applyTransform(true);
    }

    function setScrollLock(locked: boolean) {
      const docEl = document.documentElement;
      const body = document.body;
      if (locked) {
        docEl.style.overflow = "hidden";
        body.style.overflow = "hidden";
        body.style.overscrollBehavior = "none";
      } else {
        docEl.style.overflow = "";
        body.style.overflow = "";
        body.style.overscrollBehavior = "";
      }
    }

    function panRange() {
      const rect = lbImg.getBoundingClientRect();
      return {
        maxX: Math.max((rect.width - lb.clientWidth) / 2, 0) + 40,
        maxY: Math.max((rect.height - lb.clientHeight) / 2, 0) + 40,
      };
    }

    function zoomBy(factor: number) {
      const next = Math.min(4, Math.max(1, scale * factor));
      if (next === 1) {
        tx = 0;
        ty = 0;
      }
      scale = next;
      applyTransform(true);
    }

    let current = 0;
    let openSeq = 0;
    const stage = document.getElementById(
      "post-lightbox-stage"
    ) as HTMLElement | null;
    const preloadCache = new Set<string>();

    stage?.addEventListener("animationend", () => {
      stage.classList.remove("slide-in-left", "slide-in-right");
    });

    // 从 srcset 中取最大尺寸的版本，保证灯箱放大后清晰
    function pickLargestSrc(el: HTMLImageElement): string {
      const srcset = el.srcset;
      if (!srcset) return el.src;
      let best = "";
      let bestW = 0;
      for (const part of srcset.split(",")) {
        const pieces = part.trim().split(/\s+/);
        const w = pieces[1]?.endsWith("w") ? parseInt(pieces[1], 10) : 0;
        if (w > bestW) {
          bestW = w;
          best = pieces[0];
        }
      }
      return best || el.src;
    }

    // 预加载相邻图片，切换时无需等待网络
    function preloadImage(url: string) {
      if (!url || preloadCache.has(url)) return;
      preloadCache.add(url);
      const pre = new Image();
      pre.src = url;
    }

    async function open(idx: number) {
      const seq = ++openSeq;
      const direction = idx > current ? 1 : idx < current ? -1 : 0;
      current = Math.max(0, Math.min(idx, items.length - 1));
      const img = items[current];
      if (!img) return;

      const largeSrc = pickLargestSrc(img);
      lbImg.src = largeSrc;
      lbImg.alt = img.alt;

      // 预加载相邻图片
      for (const neighbor of [current - 1, current + 1]) {
        const nb = items[neighbor];
        if (nb) preloadImage(pickLargestSrc(nb));
      }

      // 等新图解码完成再一起更新文案并播放动画，避免“先显示 Alt”
      if (!reduceMotion && direction !== 0) {
        try {
          await lbImg.decode();
        } catch {
          // 解码失败时直接显示
        }
      }
      if (seq !== openSeq) return;

      if (lbCaption) lbCaption.textContent = img.alt;
      if (lbCounter)
        lbCounter.textContent = `${current + 1} / ${items.length}`;
      resetTransform();

      if (!reduceMotion && stage && direction !== 0) {
        stage.classList.remove("slide-in-left", "slide-in-right");
        void stage.offsetWidth; // 强制回流，保证动画可重复触发
        stage.classList.add(
          direction > 0 ? "slide-in-right" : "slide-in-left"
        );
      }

      // 首图隐藏“上一张”，尾图隐藏“下一张”（与画廊灯箱一致）
      if (prevBtn)
        prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
      if (nextBtn)
        nextBtn.style.visibility =
          current === items.length - 1 ? "hidden" : "visible";

      lb.showModal();
      setScrollLock(true);
    }

    function close() {
      lb.close();
      setScrollLock(false);
    }

    // 正文图片点击打开灯箱；图片位于链接内（如链接卡片缩略图）时
    // 阻止默认跳转，仅放大预览
    items.forEach((img, idx) => {
      img.addEventListener(
        "click",
        e => {
          if (img.closest("a")) e.preventDefault();
          open(idx);
        },
        { signal }
      );
    });

    // 灯箱控制按钮
    document
      .getElementById("post-lightbox-close")
      ?.addEventListener("click", close, { signal });
    document
      .getElementById("post-lightbox-prev")
      ?.addEventListener("click", () => open(current - 1), { signal });
    document
      .getElementById("post-lightbox-next")
      ?.addEventListener("click", () => open(current + 1), { signal });
    document
      .getElementById("post-lightbox-zoom-in")
      ?.addEventListener("click", () => zoomBy(1.5), { signal });
    document
      .getElementById("post-lightbox-zoom-out")
      ?.addEventListener("click", () => zoomBy(1 / 1.5), { signal });
    document
      .getElementById("post-lightbox-reset")
      ?.addEventListener("click", resetTransform, { signal });
    document
      .getElementById("post-lightbox-rotate")
      ?.addEventListener(
        "click",
        () => {
          rotation = (rotation + 90) % 360;
          applyTransform(true);
        },
        { signal }
      );

    // 滚轮缩放
    lbImg.addEventListener(
      "wheel",
      e => {
        e.preventDefault();
        zoomBy(e.deltaY < 0 ? 1.15 : 1 / 1.15);
      },
      { passive: false, signal }
    );

    // 双指缩放 + 拖拽平移
    lbImg.addEventListener(
      "pointerdown",
      e => {
        lbImg.setPointerCapture(e.pointerId);
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        lbImg.style.transition = "none";
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinchStartDistance = Math.hypot(a.x - b.x, a.y - b.y);
          pinchStartScale = scale;
          panStart = null;
        } else if (pointers.size === 1 && scale > 1) {
          panStart = { x: e.clientX, y: e.clientY, tx, ty };
          lbImg.classList.add("is-panning");
        }
      },
      { signal }
    );
    lbImg.addEventListener(
      "pointermove",
      e => {
        const prev = pointers.get(e.pointerId);
        if (!prev) return;
        if (pointers.size === 2) {
          const other = [...pointers.entries()].find(
            ([id]) => id !== e.pointerId
          );
          if (other && pinchStartDistance > 0) {
            const [, a] = other;
            const dist = Math.hypot(a.x - e.clientX, a.y - e.clientY);
            const next = Math.min(
              4,
              Math.max(1, pinchStartScale * (dist / pinchStartDistance))
            );
            if (next === 1) {
              tx = 0;
              ty = 0;
            }
            scale = next;
            applyTransform(false);
          }
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        } else if (panStart) {
          const { maxX, maxY } = panRange();
          tx = Math.max(
            -maxX,
            Math.min(maxX, panStart.tx + (e.clientX - panStart.x))
          );
          ty = Math.max(
            -maxY,
            Math.min(maxY, panStart.ty + (e.clientY - panStart.y))
          );
          applyTransform(false);
        } else {
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        }
      },
      { signal }
    );
    const endPointer = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      lbImg.classList.remove("is-panning");
      if (pointers.size < 2) pinchStartDistance = 0;
      if (pointers.size === 1) {
        const [, p] = [...pointers.entries()][0];
        panStart = scale > 1 ? { x: p.x, y: p.y, tx, ty } : null;
      } else if (pointers.size === 0) {
        panStart = null;
      }
    };
    lbImg.addEventListener("pointerup", endPointer, { signal });
    lbImg.addEventListener("pointercancel", endPointer, { signal });
    lbImg.addEventListener("lostpointercapture", endPointer, { signal });

    // 双击缩放 / 还原
    lbImg.addEventListener(
      "dblclick",
      () => {
        if (scale > 1) {
          resetTransform();
        } else {
          scale = 2;
          applyTransform(true);
        }
      },
      { signal }
    );

    // 点击背景关闭
    lb.addEventListener(
      "click",
      e => {
        if (e.target === lb) close();
      },
      { signal }
    );

    // 键盘控制——仅在灯箱打开时生效
    document.addEventListener(
      "keydown",
      e => {
        if (!lb.open) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") open(current - 1);
        if (e.key === "ArrowRight") open(current + 1);
        if (e.key === "+" || e.key === "=") zoomBy(1.25);
        if (e.key === "-" || e.key === "_") zoomBy(1 / 1.25);
        if (e.key === "0") resetTransform();
        if (e.key.toLowerCase() === "r") {
          rotation = (rotation + 90) % 360;
          applyTransform(true);
        }
      },
      { signal }
    );
  }

  initPostLightbox();
  document.addEventListener("astro:after-swap", initPostLightbox);
</script>

<style>
  /* 正文图片可点击预览 */
  :global(.app-prose img) {
    cursor: zoom-in;
  }

  /* ── Lightbox（与画廊灯箱同款交互与视觉） ── */
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: var(--background);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    flex-shrink: 0;
  }

  .lightbox-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 1.5rem;
    min-height: 0;
    gap: 1.5rem;
  }

  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.25rem;
    overflow: hidden;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .lightbox-stage.slide-in-left {
    animation: lb-slide-left 0.45s ease-out;
  }

  .lightbox-stage.slide-in-right {
    animation: lb-slide-right 0.45s ease-out;
  }

  @keyframes lb-slide-left {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes lb-slide-right {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 10rem);
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    will-change: transform;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
    cursor: grab;
  }

  .lightbox-image.is-panning {
    cursor: grabbing;
  }

  .lightbox-caption {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    text-align: center;
    max-width: 50ch;
    line-height: 1.5;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 15%, transparent);
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--background) 50%, transparent);
  }

  .lightbox-btn:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px -4px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .lightbox-nav {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-image {
      transition: none !important;
    }
    .lightbox-stage.slide-in-left,
    .lightbox-stage.slide-in-right {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .lightbox-main {
      padding: 0 3.25rem 1rem;
      gap: 0;
      position: relative;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
    }
    .lightbox-nav:hover {
      transform: translateY(-50%) scale(1.1);
    }
    .lightbox-image {
      max-height: calc(100vh - 8rem);
      max-height: calc(100dvh - 8rem);
    }
  }
</style>
