---
/**
 * ShareLinks - 文章页分享按钮组：复制链接 + 社交分享（X / 微博 / 邮件）。
 * 平台列表来自 `constants.ts` 的 SHARE_LINKS；复制按钮为组件内独立按钮。
 */
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import IconCopy from "@/assets/icons/IconCopy.svg";
import IconCheck from "@/assets/icons/IconCheck.svg";

type Props = {
  class?: string;
};

const { class: className = "" } = Astro.props;

const URL = Astro.url;
const shareBtnClass =
  "inline-flex size-8 items-center justify-center rounded-lg border border-border/20 bg-muted/5 transition-all duration-200 hover:border-accent/40 hover:bg-accent/10 hover:text-accent hover:shadow-sm hover:shadow-accent/10";
---

<div class:list={["share-links flex shrink-0 flex-col gap-2", className]}>
  <span class="font-app text-[12px] tracking-wider text-foreground/70 uppercase select-none">
    分享
  </span>
  <div class="flex items-center gap-1">
    <!-- 复制当前文章链接 -->
    <button
      type="button"
      class:list={["share-btn share-copy-btn", shareBtnClass]}
      title="复制文章链接"
      aria-label="复制文章链接"
    >
      <IconCopy class="share-icon-copy size-4 fill-transparent stroke-current stroke-2" />
      <IconCheck class="share-icon-copied hidden size-4 fill-transparent stroke-current stroke-2" />
    </button>

    {
      SHARE_LINKS.map(social => (
        <LinkButton
          href={`${social.href + URL}`}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["share-btn", shareBtnClass]}
          title={social.linkTitle}
        >
          <social.icon
            class:list={[
              social.iconClass ?? "size-4 fill-transparent stroke-current stroke-2",
            ]}
          />
          <span class="sr-only">{social.linkTitle}</span>
        </LinkButton>
      ))
    }
  </div>
</div>

<script>
  let shareCleanup: AbortController | null = null;

  function initCopyShare() {
    if (shareCleanup) shareCleanup.abort();
    shareCleanup = new AbortController();
    const { signal } = shareCleanup;

    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".share-copy-btn")
    );

    for (const button of buttons) {
      const copyIcon = button.querySelector<SVGElement>(".share-icon-copy");
      const copiedIcon = button.querySelector<SVGElement>(".share-icon-copied");
      if (!copyIcon || !copiedIcon) continue;

      let resetTimer: number | undefined;

      button.addEventListener(
        "click",
        async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyIcon.classList.add("hidden");
            copiedIcon.classList.remove("hidden");
            button.classList.add("copied");
            button.title = "链接已复制";
            button.setAttribute("aria-label", "链接已复制");

            window.clearTimeout(resetTimer);
            resetTimer = window.setTimeout(() => {
              copyIcon.classList.remove("hidden");
              copiedIcon.classList.add("hidden");
              button.classList.remove("copied");
              button.title = "复制文章链接";
              button.setAttribute("aria-label", "复制文章链接");
            }, 1800);
          } catch {
            // 复制失败时保持原状
          }
        },
        { signal }
      );
    }
  }

  document.addEventListener("astro:page-load", initCopyShare);
</script>

<style>
  .share-btn {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* 复制成功态：绿色勾选 + 绿色边框 */
  .share-copy-btn.copied {
    border-color: rgba(34, 197, 94, 0.4);
    color: #22c55e;
  }
</style>
